{
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm ds:tokens:build:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm coldlight:*)",
      "Bash(pnpm svelte-check:*)",
      "Bash(npx svelte-check:*)",
      "Bash(npx @biomejs/biome:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo doc:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git diff-index:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:v2.tauri.app)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/save-state.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/save-chat.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/restore-memory.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
