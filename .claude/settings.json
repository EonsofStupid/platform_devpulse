{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(*)",
      "WebFetch",
      "WebSearch",
      "Skill",
      "TodoWrite",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python -m pip:*)",
      "Bash(docker:*)",
      "Bash(*biome*--write*)",
      "Bash(*biome*--fix*)",
      "Bash(*biome check --apply*)",
      "Bash(*biome format --write*)",
      "Bash(*prettier*--write*)",
      "Bash(*eslint*--fix*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/save-state.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/banter-dump.js\" user-prompt",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/psych-translator.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/restore-memory.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/session-end.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/track-files.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/banter-dump.js\" stop",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/verify-on-stop.js\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const i=require('fs').readFileSync(0,'utf8');if(/docker /i.test(i)){process.stderr.write('BLOCKED: prohibited command');process.exit(2)}if(/biome[^|;&]*(--write|--fix|--apply)|prettier[^|;&]*--write|eslint[^|;&]*--fix/i.test(i)){process.stderr.write('BLOCKED: formatter auto-fix forbidden. --write removes unused imports and masks incomplete work. Run check-only, fix manually.');process.exit(2)}\""
          }
        ]
      }
    ]
  }
}
