{
  "permissions": {
    "allow": [
      "Read(//d/localdev/platform_devpulse/**)",
      "Edit(//d/localdev/platform_devpulse/**)",
      "Bash(*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:v2.tauri.app)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/save-state.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/save-chat.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/restore-memory.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
