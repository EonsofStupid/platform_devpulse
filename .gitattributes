# Enforce LF line endings for all text files
# See: https://www.aleksandrhovhannisyan.com/blog/crlf-vs-lf-normalizing-line-endings-in-git/

* text=auto eol=lf

# Explicitly mark as text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.rs text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Your recovered code (plan 0009): kept byte for byte — no line-ending
# conversion — and counted as vendored, not as this repo's languages.
recovered/** -text linguist-vendored
# Empty trailing TSV fields are column separators, not removable whitespace.
recovered/repo/SOURCES.tsv whitespace=-blank-at-eol
# Published dependency source retained byte for byte (plan 0009).
deps/tantivy-sstable/** -text linguist-vendored
