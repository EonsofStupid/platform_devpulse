# Rust
/target
/target_*/
**/*.rs.bk

# Node
node_modules
.svelte-kit
/build
/dist

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Environment
.env
.env.*
!.env.example

# HuggingFace / API secrets — kernel/model-loader/src/models/secrets.rs
# writes this next to the models_dir. Never commit.
secrets.toml
**/secrets.toml

# OS
.DS_Store
Thumbs.db

# ColdLight generated docs (regenerated by lefthook)
interfaces/desktop/src/lib/design/.cowlevel

# Platform portable data (all databases, logs, user state)
.userdata/
# Legacy data directory (migrated to .userdata/)
data/
# Embedded JSON content artifacts MUST be tracked — they're built into
# the kernel binary via `include_str!`. Without these the runtime ships
# with empty knowledge content. The bare `data/` rule above otherwise
# excludes them.
!kernel/devpulse-clyffy/src/cortex/knowledge/data/
!kernel/devpulse-clyffy/src/cortex/knowledge/data/**

# DevPulse Portable Architecture
# Ignore model weights, but keep the folder structure
models/*
!models/.keep
!models/**/.keep
history.txt
lefthook.yml
pnpm-lock.yaml
.claude/settings.local.json
.claude/worktrees/
deps/
# Vendored forks tracked as submodules — see .gitmodules.
!deps/moshi/
!deps/llama-cpp-rs/

# llama-cpp-prebuilt — extracted static libs are fetched via
# `cargo xtask fetch-llama-cpp` from github.com/EonsofStupid/llama-cpp-prebuilt
# releases. The committed manifest.json pins which release this workspace
# consumes; extracted per-target trees stay ignored.
!deps/llama-cpp-prebuilt/
deps/llama-cpp-prebuilt/win32-x64-vulkan/
deps/llama-cpp-prebuilt/win32-x64-cuda/
deps/llama-cpp-prebuilt/win32-x64-cpu/
!deps/llama-cpp-prebuilt/manifest.json

# DevForge REH trees — fetched via `cargo xtask fetch-devforge` from
# github.com/EonsofStupid/devforge releases. The committed manifest.json
# is the SSOT; extracted trees are reproducible from it and must never
# be committed (70+ MB per platform).
interfaces/desktop/src-tauri/resources/devforge/win32-x64/
interfaces/desktop/src-tauri/resources/devforge/darwin-arm64/
interfaces/desktop/src-tauri/resources/devforge/darwin-x64/
interfaces/desktop/src-tauri/resources/devforge/linux-x64/
!interfaces/desktop/src-tauri/resources/devforge/manifest.json
