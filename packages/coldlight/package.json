{
	"name": "@devpulse/coldlight",
	"version": "0.2.1",
	"description": "Liquid surface design system - particle effects, metal, glass, molten aesthetics. Named for Tesla's cold light gas tubes (1870s).",
	"author": "Jesse \"Hades\" Hall <jessay@angryvibers.com>",
	"maintainers": [
		"team@devpulse.app"
	],
	"license": "MIT",
	"private": true,
	"type": "module",
	"exports": {
		"./index.css": "./index.css",
		"./actions": {
			"types": "./actions/index.ts",
			"svelte": "./actions/index.ts",
			"default": "./actions/index.ts"
		},
		"./behaviors": {
			"types": "./behaviors/index.ts",
			"svelte": "./behaviors/index.ts",
			"default": "./behaviors/index.ts"
		},
		"./blocks": {
			"types": "./blocks/index.ts",
			"svelte": "./blocks/index.ts",
			"default": "./blocks/index.ts"
		},
		"./blocks/*": {
			"types": "./blocks/*/index.ts",
			"svelte": "./blocks/*/index.ts",
			"default": "./blocks/*/index.ts"
		},
		"./components/*": {
			"types": "./components/*/index.ts",
			"svelte": "./components/*/index.ts",
			"default": "./components/*/index.ts"
		},
		"./config": {
			"types": "./coldlight.config.ts",
			"svelte": "./coldlight.config.ts",
			"default": "./coldlight.config.ts"
		},
		"./debug": {
			"types": "./debug/index.ts",
			"svelte": "./debug/index.ts",
			"default": "./debug/index.ts"
		},
		"./generated/*": "./generated/*",
		"./overlays": {
			"types": "./overlays/index.ts",
			"svelte": "./overlays/index.ts",
			"default": "./overlays/index.ts"
		},
		"./plugins/*": {
			"types": "./plugins/*/index.ts",
			"svelte": "./plugins/*/index.ts",
			"default": "./plugins/*/index.ts"
		},
		"./primitives": {
			"types": "./primitives/index.ts",
			"svelte": "./primitives/index.ts",
			"default": "./primitives/index.ts"
		},
		"./primitives/*": {
			"svelte": "./primitives/*/index.ts"
		},
		"./presets": {
			"types": "./presets/index.ts",
			"svelte": "./presets/index.ts",
			"default": "./presets/index.ts"
		},
		"./renderforge": {
			"types": "./renderforge/index.ts",
			"svelte": "./renderforge/index.ts",
			"default": "./renderforge/index.ts"
		},
		"./style-macro": {
			"types": "./renderforge/index.ts",
			"svelte": "./renderforge/index.ts",
			"default": "./renderforge/index.ts"
		},
		"./svg": {
			"types": "./svg/index.ts",
			"svelte": "./svg/index.ts",
			"default": "./svg/index.ts"
		},
		"./svg/filters": {
			"types": "./svg/filters/index.ts",
			"svelte": "./svg/filters/index.ts",
			"default": "./svg/filters/index.ts"
		},
		"./utils": {
			"types": "./utils/index.ts",
			"svelte": "./utils/index.ts",
			"default": "./utils/index.ts"
		},
		"./utils/*": {
			"types": "./utils/*/index.ts",
			"svelte": "./utils/*/index.ts",
			"default": "./utils/*/index.ts"
		},
		"./visual": {
			"types": "./visual/index.ts",
			"svelte": "./visual/index.ts",
			"default": "./visual/index.ts"
		}
	},
	"imports": {
		"#coldlight/*": "./*"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"arktype": "catalog:",
		"clsx": "catalog:",
		"lucide-svelte": "catalog:",
		"shiki": "catalog:"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"tailwindcss": ">=4.0.0",
		"vite": ">=5.0.0"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.59.4",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"playwright": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typedoc": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	},
	"keywords": [
		"design-system",
		"svelte",
		"sveltekit",
		"tailwind",
		"oklch",
		"liquid-surface",
		"style-dictionary",
		"dtcg",
		"dark-mode",
		"tesla",
		"ui"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/devpulse/platform_devpulse",
		"directory": "packages/coldlight"
	},
	"bugs": {
		"email": "team@devpulse.app"
	},
	"engines": {
		"node": ">=18"
	}
}
