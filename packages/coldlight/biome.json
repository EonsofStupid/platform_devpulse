{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"extends": "//",
	"overrides": [
		{
			"includes": ["builders/**/*.ts", "builders/**/*.svelte.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@melt-ui/svelte": "builders/ must not import third-party headless libraries. ColdLight-owned only.",
									"@melt-ui/svelte/internal/helpers": "builders/ must not import third-party headless internals."
								},
								"patterns": [
									{
										"group": ["**/_archive/*", "**/_archive/**"],
										"message": "Archive imports are banned. Build from taxonomy contracts."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["styles/**", "css/**", "theme/**", "generated/**", "svg/**", "plugins/**"],
			"linter": {
				"rules": {
					"style": {
						"noHexColors": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"!.cowlevel",
			"!style",
			"!styles",
			"!css",
			"!theme",
			"!generated",
			"!svg",
			"!plugins",
			"!primitives/_archive",
			"!primitives/tanstack/flex-render.svelte",
			"!taxonomy/.generated/coldlight.manifest.json"
		]
	}
}
