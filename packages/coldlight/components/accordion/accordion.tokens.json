{
	"$description": "Restores the accordion item, trigger and content styling from design/shortcodes/components/accordion.css.",
	"accordion": {
		"$extensions": { "com.coldlight": { "slot": "item", "accepts": ["frame"] } },
		"base": {
			"border-bottom": { "$value": "0.0625rem solid {interaction.hover}" }
		},
		"part": {
			"trigger": {
				"padding-inline": { "$value": "{space.4}", "$type": "dimension" },
				"padding-block": { "$value": "{space.3}", "$type": "dimension" },
				"font-weight": { "$value": 500, "$type": "fontWeight" },
				"color": { "$value": "{text.primary}", "$type": "color" },
				"state": {
					"hover": { "background-color": { "$value": "{interaction.hover}", "$type": "color" } },
					"focus-visible": { "outline-style": { "$value": "solid" }, "outline-width": { "$value": "0.125rem", "$type": "dimension" }, "outline-color": { "$value": "{border.focus}", "$type": "color" }, "outline-offset": { "$value": "0.125rem", "$type": "dimension" } },
					"disabled": { "opacity": { "$value": 0.5, "$type": "number" }, "cursor": { "$value": "not-allowed" } }
				}
			},
			"content": {
				"padding-inline": { "$value": "{space.4}", "$type": "dimension" },
				"padding-bottom": { "$value": "{space.4}", "$type": "dimension" },
				"color": { "$value": "{text.secondary}", "$type": "color" }
			},
			"indicator": { "color": { "$value": "{text.muted}", "$type": "color" } }
		}
	}
}
