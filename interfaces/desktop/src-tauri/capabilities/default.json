{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capability — all windows",
	"windows": ["*"],
	"permissions": [
		"core:default",
		"core:window:allow-minimize",
		"shell:allow-open",
		"shell:allow-execute",
		"shell:allow-spawn",
		"shell:allow-kill",
		"shell:allow-stdin-write",
		"global-shortcut:allow-register",
		"updater:default"
	]
}
