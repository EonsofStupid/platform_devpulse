{
	"productName": "devpulse-desktop",
	"version": "0.1.0",
	"identifier": "com.devpulse.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist",
		"features": ["inference"]
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "DevPulse",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"resizable": true,
				"transparent": false,
				"decorations": true,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": [
			"binaries/llama-server"
		],
		"resources": [
			"binaries/llama.dll",
			"binaries/llama-common.dll",
			"binaries/ggml.dll",
			"binaries/ggml-base.dll",
			"binaries/ggml-cuda.dll",
			"binaries/ggml-cpu-haswell.dll",
			"binaries/cublas64_12.dll",
			"binaries/cublasLt64_12.dll",
			"binaries/cudart64_12.dll",
			"binaries/libomp140.x86_64.dll"
		]
	}
}
