{
	"productName": "devpulse-desktop",
	"version": "0.1.0",
	"identifier": "com.devpulse.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist",
		"features": ["inference"]
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "DevPulse",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"resizable": true,
				"transparent": false,
				"decorations": true,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/llama-server", "binaries/surreal"],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico"
			}
		}
	}
}
