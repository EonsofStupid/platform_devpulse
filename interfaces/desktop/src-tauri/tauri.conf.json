{
	"productName": "devpulse-desktop",
	"version": "0.1.0",
	"identifier": "com.devpulse.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "splashscreen",
				"title": "DevPulse",
				"url": "/splashscreen",
				"width": 800,
				"height": 600,
				"center": true,
				"decorations": false,
				"resizable": false,
				"transparent": true,
				"alwaysOnTop": true
			},
			{
				"label": "main",
				"title": "DevPulse",
				"width": 1280,
				"height": 800,
				"transparent": true,
				"decorations": false,
				"visible": false
			},
			{
				"label": "chat",
				"title": "Maestro Chat",
				"url": "/chat",
				"width": 450,
				"height": 600,
				"x": 100,
				"y": 100,
				"visible": true,
				"decorations": false,
				"transparent": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
