language js

// IP boundary enforcement — block kernel terms in frontend string literals.
// SSOT: systems/devpulse-engine/ip/kernel_terms.toml
//
// These terms are protected IP and must NEVER appear in customer-facing code.
// Use the public equivalent from the "engine" column in kernel_terms.toml.

sequential {
	// Sub-agent names
	`$str` where {
		$str <: string_fragment(),
		$str <: or {
			r"DIARY",
			r"GUARDIAN",
			r"PSYCH",
			r"TEACHER",
			r"SCRIBE",
			r"VISION",
			r"RESEARCHER",
			r"ENFORCER",
			r"sub-agent",
			r"Minion"
		},
		register_diagnostic(span=$str, message="Kernel sub-agent name in frontend string. Use the public equivalent from kernel_terms.toml.")
	},
	// Architecture terms
	`$str` where {
		$str <: string_fragment(),
		$str <: or {
			r"Maestro",
			r"Cortex",
			r"Trinity",
			r"OverMind"
		},
		register_diagnostic(span=$str, message="Kernel architecture term in frontend string. Use: Gus, knowledge engine, data layer, or sandbox.")
	},
	// Rumination architecture
	`$str` where {
		$str <: string_fragment(),
		$str <: or {
			r"rumination",
			r"rumination layer",
			r"keystroke layer",
			r"pause layer",
			r"send layer",
			r"background layer",
			r"latency budget",
			r"KV cache warmth"
		},
		register_diagnostic(span=$str, message="Kernel rumination term in frontend string. Use: thinking, quick read, context check, deep thinking, etc.")
	},
	// COSTAR+ internals
	`$str` where {
		$str <: string_fragment(),
		$str <: or {
			r"COSTAR\+",
			r"COSTAR",
			r"Context-Objective-Style-Tone-Audience-Response",
			r"vibe-speak",
			r"engineer-speak",
			r"translation layer",
			r"provider-specific frame",
			r"frame tuning"
		},
		register_diagnostic(span=$str, message="Kernel COSTAR term in frontend string. Use: prompt builder, natural language, smart formatting, etc.")
	},
	// Algorithm names
	`$str` where {
		$str <: string_fragment(),
		$str <: or {
			r"\bHMM\b",
			r"Hidden Markov Model",
			r"state transition matrix",
			r"RRF fusion",
			r"Reciprocal Rank Fusion",
			r"\bCAG\b",
			r"Context-Augmented Generation",
			r"RAG pipeline",
			r"Retrieval-Augmented Generation",
			r"\bRRO\b",
			r"Reasoning Ready Object",
			r"\bBM25\b",
			r"hybrid search",
			r"speculative decoding",
			r"zero-copy deserialization",
			r"cross-encoder",
			r"dense retrieval",
			r"reranking",
			r"RKYV"
		},
		register_diagnostic(span=$str, message="Kernel algorithm name in frontend string. Use the public equivalent from kernel_terms.toml.")
	}
}
