{
	"extends": "stylelint-config-standard",
	"customSyntax": "postcss-html",
	"rules": {
		"color-no-hex": true,
		"color-named": "never",
		"declaration-property-value-allowed-list": {
			"color": ["/^var\\(--/", "/^currentColor$/", "/^inherit$/", "/^transparent$/"],
			"background-color": ["/^var\\(--/", "/^transparent$/", "/^inherit$/"],
			"border-color": ["/^var\\(--/", "/^transparent$/", "/^currentColor$/", "/^inherit$/"],
			"fill": ["/^var\\(--/", "/^none$/", "/^currentColor$/"],
			"stroke": ["/^var\\(--/", "/^none$/", "/^currentColor$/"],
			"box-shadow": ["/^var\\(--/", "/^none$/", "/currentColor/"],
			"font-family": ["/^var\\(--/", "/^inherit$/"]
		},
		"declaration-property-unit-disallowed-list": {
			"/./": ["px"]
		},
		"at-rule-no-unknown": [true, {
			"ignoreAtRules": ["tailwind", "apply", "layer", "theme", "utility", "variant", "import"]
		}],
		"function-no-unknown": [true, {
			"ignoreFunctions": ["theme", "oklch"]
		}],
		"import-notation": null,
		"no-descending-specificity": null
	},
	"ignoreFiles": [
		"src/lib/design/css/**",
		"src/lib/design/theme/**",
		"src/lib/design/style/**",
		"src/lib/design/styles/**",
		"src/lib/design/generated/**",
		"src/lib/design/svg/**",
		"src/lib/design/.cowlevel/**",
		"src/lib/design/plugins/**",
		"src/lib/sys/debug/vpb/**",
		"node_modules/**",
		".svelte-kit/**",
		"dist/**"
	]
}
