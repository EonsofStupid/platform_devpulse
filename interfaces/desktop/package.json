{
	"name": "devpulse-desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "vitest run && playwright test",
		"headers:check": "npx tsx scripts/dev/inject-headers.ts check",
		"headers:inject": "npx tsx scripts/dev/inject-headers.ts inject",
		"ds:tokens:build": "npx tsx scripts/dev/design/ds-tokens-build.ts",
		"ds:tokens:watch": "npx tsx --watch scripts/dev/design/ds-tokens-build.ts",
		"audit:primitives": "npx tsx scripts/dev/design/audit-primitives.ts",
		"audit:primitives:json": "npx tsx scripts/dev/design/audit-primitives.ts --json",
		"audit:primitives:ci": "npx tsx scripts/dev/design/audit-primitives.ts --ci",
		"docs:primitives": "npx tsx scripts/dev/design/audit-primitives.ts --update-md",
		"coldlight:generate": "npx tsx scripts/coldlight/generate-manifest.ts",
		"coldlight:verify": "npx tsx scripts/coldlight/verify-manifest.ts",
		"coldlight:docs": "npx tsx scripts/coldlight/generate-docs.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@playwright/test": "^1.58.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@tsconfig/svelte": "^5.0.0",
		"@types/node": "^25.0.9",
		"@typescript-eslint/types": "^8.53.1",
		"@vitest/browser-playwright": "^4.0.17",
		"@vitest/coverage-v8": "^4.0.17",
		"autoprefixer": "^10.4.23",
		"esbuild": "^0.27.2",
		"jsdom": "^27.4.0",
		"melt": "^0.44.0",
		"msw": "^2.12.7",
		"postcss": "^8.5.6",
		"prisma": "^7.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.4.1",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.16",
		"typedoc-plugin-markdown": "^4.9.0",
		"typescript": "^5.0.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.17",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/orbitron": "^5.2.8",
		"@prisma/client": "^7.3.0",
		"@sveltejs/kit": "^2.50.0",
		"@tanstack/svelte-query": "^6.0.17",
		"@tanstack/svelte-table": "^8.21.3",
		"@tanstack/svelte-virtual": "^3.13.18",
		"@tanstack/table-core": "^8.21.3",
		"@tauri-apps/api": "^2.0.0-rc",
		"@tauri-apps/plugin-shell": "^2.0.0-rc",
		"@xyflow/svelte": "^1.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.0",
		"lucide-svelte": "^0.563.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^2.2.0",
		"zod": "^4.3.5"
	}
}
