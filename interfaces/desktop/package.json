{
	"name": "devpulse-desktop",
	"version": "2.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"generate:terminology": "tsx scripts/build/terminology/generate.ts",
		"bindings:regen": "cd ../.. && cargo xtask regen-bindings",
		"dev": "pnpm generate:terminology && vite dev",
		"build": "pnpm generate:terminology && vite build",
		"build:full": "pnpm bindings:regen && pnpm generate:terminology && vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:ipc": "node scripts/dev/check-no-raw-invoke.mjs",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "vitest run && playwright test",
		"headers:check": "tsx scripts/dev/inject-headers.ts check",
		"headers:inject": "tsx scripts/dev/inject-headers.ts inject",
		"headers:fix": "tsx scripts/dev/inject-headers.ts fix",
		"headers:validate": "tsx scripts/dev/inject-headers.ts validate",
		"ds:tokens:build": "node scripts/build/styledictionary/build.mjs",
		"audit:cssvars": "node scripts/audit/css-var-audit.mjs",
		"audit:color": "node scripts/audit/color-audit.mjs",
		"audit:presetmap": "node scripts/audit/preset-map.mjs",
		"audit:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
		"audit:deps:graph": "depcruise src/lib/design --config .dependency-cruiser.cjs --output-type mermaid",
		"audit:unused": "knip",
		"platform:scan": "tsx scripts/dev/platform-scanner.ts",
		"platform:scan:json": "tsx scripts/dev/platform-scanner.ts --json",
		"platform:scan:write": "tsx scripts/dev/platform-scanner.ts --write",
		"coldlight:verify": "tsx scripts/build/verify-manifest.ts",
		"coldlight:docs": "tsx scripts/build/generate-docs.ts",
		"audit:primitives": "tsx scripts/build/design/audit-primitives.ts",
		"docs:api": "typedoc --options src/lib/design/typedoc.json",
		"docs:api:json": "typedoc --options src/lib/design/typedoc.json --json src/lib/design/.cowlevel/api.json",
		"test:browser": "vitest --browser",
		"test:ci": "CI=true vitest run",
		"test:arch": "vitest run --config vitest.config.arch.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@chromatic-com/storybook": "^5.2.1",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@floating-ui/dom": "^1.8.0",
		"@playwright/test": "^1.61.1",
		"@storybook/addon-a11y": "^10.5.3",
		"@storybook/addon-actions": "^9.0.8",
		"@storybook/addon-console": "^3.0.0",
		"@storybook/addon-designs": "^11.1.4",
		"@storybook/addon-docs": "^10.5.3",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-themes": "^10.5.3",
		"@storybook/addon-vitest": "^10.5.3",
		"@storybook/sveltekit": "^10.5.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "~2.11.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.9.5",
		"@types/three": "^0.184.1",
		"@typescript-eslint/types": "^8.65.0",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/browser-preview": "^4.1.10",
		"@vitest/browser-webdriverio": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"autoprefixer": "^10.5.4",
		"culori": "^4.0.2",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.27.7",
		"jiti": "^2.7.0",
		"jsdom": "^27.4.0",
		"knip": "^6.27.0",
		"msw": "^2.15.0",
		"playwright": "^1.61.1",
		"postcss": "^8.5.21",
		"prisma": "^7.9.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"smol-toml": "^1.7.0",
		"storybook": "^10.5.3",
		"style-dictionary": "^5.5.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tsx": "^4.23.1",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-plugin-mermaid": "^1.12.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1",
		"vitest-preview": "^0.0.3"
	},
	"dependencies": {
		"3d-force-graph": "^1.80.0",
		"@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/orbitron": "^5.3.0",
		"@lucide/svelte": "^1.25.0",
		"@prisma/client": "^7.9.0",
		"@supabase/supabase-js": "^2.110.8",
		"@sveltejs/kit": "^2.70.1",
		"@tanstack/svelte-query": "^6.1.38",
		"@tanstack/svelte-table": "^8.21.3",
		"@tanstack/svelte-virtual": "^3.13.33",
		"@tanstack/table-core": "^8.21.3",
		"@tauri-apps/api": "~2.11.1",
		"@tauri-apps/plugin-shell": "~2.3.5",
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"@xyflow/svelte": "^1.6.2",
		"a2ui": "github:eonsofstupid/a2ui",
		"arktype": "^2.2.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"shiki": "^4.3.1",
		"style-dictionary-utils": "^6.0.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"three": "^0.184.0"
	}
}
