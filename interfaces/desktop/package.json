{
    "name": "devpulse-desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "headers:check": "npx tsx scripts/dev/inject-headers.ts check",
        "headers:inject": "npx tsx scripts/dev/inject-headers.ts inject",
        "ds:tokens:build": "npx tsx scripts/dev/design/ds-tokens-build.ts",
        "ds:tokens:watch": "npx tsx --watch scripts/dev/design/ds-tokens-build.ts",
        "audit:primitives": "npx tsx scripts/dev/design/audit-primitives.ts",
        "audit:primitives:json": "npx tsx scripts/dev/design/audit-primitives.ts --json",
        "audit:primitives:ci": "npx tsx scripts/dev/design/audit-primitives.ts --ci",
        "docs:primitives": "npx tsx scripts/dev/design/audit-primitives.ts --update-md"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@tsconfig/svelte": "^5.0.0",
        "@types/node": "^25.0.9",
        "@typescript-eslint/types": "^8.53.1",
        "@vitest/browser-playwright": "^4.0.17",
        "@vitest/coverage-v8": "^4.0.17",
        "autoprefixer": "^10.4.23",
        "esbuild": "^0.27.2",
        "jsdom": "^27.4.0",
        "postcss": "^8.5.6",
        "prisma": "^7.3.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.3.5",
        "tailwindcss": "^4.1.18",
        "tslib": "^2.4.1",
        "tsx": "^4.21.0",
        "typescript": "^5.0.0",
        "vite": "^7.3.1",
        "vitest": "^4.0.17",
        "vitest-browser-svelte": "^2.0.1"
    },
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@melt-ui/svelte": "^0.86.6",
        "@prisma/client": "^7.3.0",
        "@sveltejs/kit": "^2.50.0",
        "@tanstack/svelte-query": "^6.0.17",
        "@tanstack/svelte-table": "^8.21.3",
        "@tanstack/svelte-virtual": "^3.13.18",
        "@tanstack/table-core": "^8.21.3",
        "@tauri-apps/api": "^2.0.0-rc",
        "@tauri-apps/plugin-shell": "^2.0.0-rc",
        "clsx": "^2.1.0",
        "svelte-sonner": "^1.0.7",
        "tailwind-merge": "^2.2.0",
        "zod": "^4.3.5"
    }
}
