{
	"name": "devpulse-desktop",
	"version": "2.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"generate:terminology": "tsx scripts/build/terminology/generate.ts",
		"bindings:regen": "cd ../.. && cargo xtask regen-bindings",
		"dev": "node scripts/build/styledictionary/build.mjs && tsx scripts/build/terminology/generate.ts && vite dev",
		"build": "node scripts/build/styledictionary/build.mjs && tsx scripts/build/terminology/generate.ts && vite build",
		"build:full": "pnpm bindings:regen && pnpm build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:stories": "svelte-check --tsconfig ./tsconfig.stories.json",
		"check:ipc": "node scripts/dev/check-no-raw-invoke.mjs",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "vitest run && playwright test",
		"headers:check": "tsx scripts/dev/inject-headers.ts check",
		"headers:inject": "tsx scripts/dev/inject-headers.ts inject",
		"headers:fix": "tsx scripts/dev/inject-headers.ts fix",
		"headers:validate": "tsx scripts/dev/inject-headers.ts validate",
		"ds:tokens:build": "node scripts/build/styledictionary/build.mjs",
		"ds:tokens:check": "node scripts/build/styledictionary/build.mjs --check",
		"ds:tokens:test": "node --test scripts/build/styledictionary/*.test.mjs",
		"ds:generate": "tsx scripts/dev/design/coldlight-generate.ts",
		"ds:validate": "tsx scripts/dev/design/coldlight-validate.ts",
		"ds:build": "pnpm ds:tokens:build && pnpm ds:generate",
		"ds:build:full": "pnpm ds:tokens:build && pnpm ds:generate && pnpm ds:validate",
		"audit:primitives": "node scripts/coldlight/design/audit-primitives.ts",
		"audit:primitives:json": "node scripts/coldlight/design/audit-primitives.ts --json",
		"audit:primitives:ci": "node scripts/coldlight/design/audit-primitives.ts --ci",
		"docs:primitives": "node scripts/coldlight/design/audit-primitives.ts --update-md",
		"platform:scan": "tsx scripts/dev/platform-scanner.ts",
		"platform:scan:json": "tsx scripts/dev/platform-scanner.ts --json",
		"platform:scan:write": "tsx scripts/dev/platform-scanner.ts --write",
		"coldlight:inventory": "tsx scripts/coldlight/generate-inventory.ts",
		"coldlight:inventory:write": "tsx scripts/coldlight/generate-inventory.ts --write",
		"coldlight:generate": "tsx scripts/coldlight/generate-manifest.ts",
		"coldlight:verify": "tsx scripts/coldlight/verify-manifest.ts",
		"coldlight:docs": "tsx scripts/coldlight/generate-docs.ts",
		"docs:api": "typedoc --options ../../packages/coldlight/typedoc.json",
		"docs:api:json": "typedoc --options ../../packages/coldlight/typedoc.json --json ../../packages/coldlight/.cowlevel/api.json",
		"test:browser": "vitest --browser",
		"test:ci": "CI=true vitest run",
		"test:arch": "vitest run --config vitest.config.arch.ts",
		"storybook": "pnpm ds:tokens:build && storybook dev -p 6006",
		"build-storybook": "pnpm ds:tokens:build && pnpm check:stories && storybook build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@chromatic-com/storybook": "^5.6.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@floating-ui/dom": "^1.8.0",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-actions": "^9.0.8",
		"@storybook/addon-console": "^3.0.0",
		"@storybook/addon-designs": "^12.0.0",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-themes": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/sveltekit": "^10.6.5",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.4",
		"@tauri-apps/cli": "~2.12.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "catalog:",
		"@types/three": "^0.187.0",
		"@typescript-eslint/types": "^8.72.1",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/browser-preview": "^5.1.0",
		"@vitest/browser-webdriverio": "^5.0.0",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "^5.1.0",
		"aria-query": "^5.3.2",
		"autoprefixer": "^10.6.2",
		"culori": "^4.0.2",
		"dotenv": "^18.0.9",
		"esbuild": "^0.28.2",
		"jiti": "^2.7.0",
		"jsdom": "^30.1.3",
		"msw": "^3.0.3",
		"playwright": "catalog:",
		"postcss": "^8.5.32",
		"prisma": "^7.10.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"smol-toml": "^1.9.1",
		"storybook": "^10.6.5",
		"style-dictionary": "^5.8.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"typedoc": "catalog:",
		"typedoc-plugin-markdown": "^4.14.1",
		"typedoc-plugin-mermaid": "^1.12.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:",
		"vitest-preview": "^0.0.3"
	},
	"dependencies": {
		"3d-force-graph": "^1.80.1",
		"@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
		"@devpulse/coldlight": "workspace:*",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/orbitron": "^5.3.0",
		"@prisma/client": "^7.10.1",
		"@supabase/supabase-js": "^2.119.0",
		"@sveltejs/kit": "^3.1.1",
		"@tanstack/svelte-query": "^6.3.9",
		"@tanstack/svelte-table": "^9.3.1",
		"@tanstack/svelte-virtual": "^3.13.52",
		"@tanstack/table-core": "^9.3.1",
		"@tauri-apps/api": "~2.12.4",
		"@tauri-apps/plugin-shell": "~2.6.0",
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"@xyflow/svelte": "^1.7.1",
		"a2ui": "github:eonsofstupid/a2ui",
		"arktype": "catalog:",
		"class-variance-authority": "^0.7.1",
		"clsx": "catalog:",
		"lucide-svelte": "catalog:",
		"shiki": "catalog:",
		"style-dictionary-utils": "^6.0.1",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"three": "^0.187.0"
	}
}
