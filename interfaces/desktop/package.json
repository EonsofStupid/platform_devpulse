{
	"name": "devpulse-desktop",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generate:terminology": "tsx scripts/build/terminology/generate.ts",
		"bindings:regen": "cd ../.. && cargo xtask regen-bindings",
		"dev": "pnpm generate:terminology && vite dev",
		"build": "pnpm generate:terminology && vite build",
		"build:full": "pnpm bindings:regen && pnpm generate:terminology && vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:ipc": "node scripts/dev/check-no-raw-invoke.mjs",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "vitest run && playwright test",
		"headers:check": "tsx scripts/dev/inject-headers.ts check",
		"headers:inject": "tsx scripts/dev/inject-headers.ts inject",
		"headers:fix": "tsx scripts/dev/inject-headers.ts fix",
		"headers:validate": "tsx scripts/dev/inject-headers.ts validate",
		"ds:tokens:build": "node scripts/build/styledictionary/build.mjs",
		"ds:generate": "tsx scripts/dev/design/coldlight-generate.ts",
		"ds:validate": "tsx scripts/dev/design/coldlight-validate.ts",
		"ds:build": "pnpm ds:tokens:build && pnpm ds:generate",
		"ds:build:full": "pnpm ds:tokens:build && pnpm ds:generate && pnpm ds:validate",
		"audit:primitives": "node scripts/dev/design/audit-primitives.ts",
		"audit:primitives:json": "node scripts/dev/design/audit-primitives.ts --json",
		"audit:primitives:ci": "node scripts/dev/design/audit-primitives.ts --ci",
		"docs:primitives": "node scripts/dev/design/audit-primitives.ts --update-md",
		"platform:scan": "tsx scripts/dev/platform-scanner.ts",
		"platform:scan:json": "tsx scripts/dev/platform-scanner.ts --json",
		"platform:scan:write": "tsx scripts/dev/platform-scanner.ts --write",
		"coldlight:inventory": "tsx scripts/coldlight/generate-inventory.ts",
		"coldlight:inventory:write": "tsx scripts/coldlight/generate-inventory.ts --write",
		"coldlight:generate": "tsx scripts/coldlight/generate-manifest.ts",
		"coldlight:verify": "tsx scripts/coldlight/verify-manifest.ts",
		"coldlight:docs": "tsx scripts/coldlight/generate-docs.ts",
		"docs:api": "typedoc --options src/lib/design/typedoc.json",
		"docs:api:json": "typedoc --options src/lib/design/typedoc.json --json src/lib/design/.cowlevel/api.json",
		"test:browser": "vitest --browser",
		"test:ci": "CI=true vitest run",
		"test:arch": "vitest run --config vitest.config.arch.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@chromatic-com/storybook": "^5.0.2",
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@floating-ui/dom": "^1.7.5",
		"@playwright/test": "^1.58.1",
		"@storybook/addon-a11y": "^10.3.0",
		"@storybook/addon-actions": "^9.0.8",
		"@storybook/addon-console": "^3.0.0",
		"@storybook/addon-designs": "^11.1.2",
		"@storybook/addon-docs": "^10.3.0",
		"@storybook/addon-svelte-csf": "^5.0.12",
		"@storybook/addon-themes": "^10.3.1",
		"@storybook/addon-vitest": "^10.3.0",
		"@storybook/sveltekit": "^10.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@tauri-apps/cli": "~2.10.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@tsconfig/svelte": "^5.0.0",
		"@types/node": "^25.0.9",
		"@types/three": "^0.184.0",
		"@typescript-eslint/types": "^8.53.1",
		"@vitest/browser-playwright": "^4.0.17",
		"@vitest/browser-preview": "^4.0.18",
		"@vitest/browser-webdriverio": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.17",
		"@vitest/ui": "^4.0.18",
		"aria-query": "^5.3.2",
		"autoprefixer": "^10.4.23",
		"culori": "^4.0.2",
		"esbuild": "^0.27.2",
		"jiti": "^2.6.1",
		"jsdom": "^27.4.0",
		"msw": "^2.12.10",
		"playwright": "^1.58.2",
		"postcss": "^8.5.6",
		"prisma": "^7.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"smol-toml": "^1.6.0",
		"storybook": "^10.3.0",
		"style-dictionary": "^5.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.8.1",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.17",
		"typedoc-plugin-markdown": "^4.10.0",
		"typedoc-plugin-mermaid": "^1.12.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2",
		"vitest-preview": "^0.0.3"
	},
	"dependencies": {
		"3d-force-graph": "^1.80.0",
		"@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/orbitron": "^5.2.8",
		"@prisma/client": "^7.4.0",
		"@sveltejs/kit": "^2.52.0",
		"@supabase/supabase-js": "^2.47.0",
		"@tanstack/svelte-query": "^6.0.18",
		"@tanstack/svelte-table": "^8.21.3",
		"@tanstack/svelte-virtual": "^3.13.18",
		"@tanstack/table-core": "^8.21.3",
		"@tauri-apps/api": "~2.10.1",
		"@tauri-apps/plugin-shell": "~2.3.5",
		"@threlte/core": "^8.5.9",
		"@threlte/extras": "^9.14.9",
		"@xyflow/svelte": "^1.5.0",
		"a2ui": "github:eonsofstupid/a2ui",
		"arktype": "^2.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-svelte": "^0.564.0",
		"shiki": "^4.0.2",
		"style-dictionary-utils": "^6.0.1",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.1",
		"three": "^0.184.0"
	}
}
