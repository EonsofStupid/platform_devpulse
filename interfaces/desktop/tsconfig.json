{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"useDefineForClassFields": true,
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": ["**/*.d.ts", "**/*.ts", "**/*.js", "**/*.svelte"],
	"exclude": [
		"node_modules",
		"**/node_modules",
		"dist",
		"storybook-static",
		"src/lib/design/**",
		"src/lib/domains/app/models/feature/setup-wizard/_archive/**",
		"src/lib/design/primitives/_archive/**",
		"src/stories/**"
	],
	"references": [
		{
			"path": "./tsconfig.node.json"
		}
	]
}
