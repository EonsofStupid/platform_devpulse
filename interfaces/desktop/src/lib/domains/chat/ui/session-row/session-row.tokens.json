{
	"chat-session-row": {
		"$extensions": {
			"com.coldlight": { "accepts": ["interactive"], "slot": "root" }
		},
		"base": {
			"border-left-width": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
			"border-left-color": { "$type": "color", "$value": "transparent" },
			"border-radius": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } }
		},
		"state": {
			"selected": {
				"background-color": { "$type": "color", "$value": "var(--accent-teal-fill)" },
				"border-left-color": { "$type": "color", "$value": "var(--accent-teal-main)" },
				"box-shadow": { "$value": "none" }
			}
		},
		"part": {
			"timestamp": { "color": { "$type": "color", "$value": "{text.muted}" } }
		}
	}
}
