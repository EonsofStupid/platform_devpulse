{
	"name": "@devpulse/coldlight",
	"version": "0.1.0",
	"description": "Liquid surface design system - particle effects, metal, glass, molten aesthetics. Named for Tesla's cold light gas tubes (1870s).",
	"author": "Jesse \"Hades\" Hall <jessay@angryvibers.com>",
	"maintainers": [
		"team@devpulse.app"
	],
	"license": "MIT",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.ts"
		},
		"./config": {
			"types": "./coldlight.config.d.ts",
			"import": "./coldlight.config.ts"
		},
		"./manifest": {
			"types": "./manifest.d.ts",
			"import": "./manifest.ts"
		},
		"./constraints": {
			"types": "./constraints.d.ts",
			"import": "./constraints.ts"
		},
		"./tokens": {
			"types": "./tokens/types.ts",
			"import": "./tokens/tokens.ts"
		},
		"./tokens/css": "./tokens/tokens.css",
		"./taxonomy": {
			"types": "./taxonomy/index.d.ts",
			"import": "./taxonomy/index.ts"
		},
		"./recipes": {
			"types": "./recipes/index.d.ts",
			"import": "./recipes/index.ts"
		},
		"./recipes/css": "./recipes/css/surfaces.gen.css",
		"./primitives": {
			"types": "./primitives/index.d.ts",
			"svelte": "./primitives/index.ts"
		},
		"./vite-plugin": {
			"types": "./vite-plugin.d.ts",
			"import": "./vite-plugin.ts"
		},
		"./tailwind-preset": {
			"types": "./tokens/tailwind.preset.d.ts",
			"import": "./tokens/tailwind.preset.ts"
		}
	},
	"files": [
		"tokens/",
		"taxonomy/",
		"recipes/",
		"primitives/",
		"index.ts",
		"index.css",
		"coldlight.config.ts",
		"manifest.ts",
		"constraints.ts",
		"CHANGELOG.md",
		"vite-plugin.ts"
	],
	"keywords": [
		"design-system",
		"svelte",
		"sveltekit",
		"tailwind",
		"oklch",
		"liquid-surface",
		"particle-effects",
		"molten",
		"metal",
		"glass",
		"dark-mode",
		"tesla",
		"ui"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/devpulse/platform_devpulse",
		"directory": "interfaces/desktop/src/lib/design"
	},
	"bugs": {
		"email": "team@devpulse.app"
	},
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"@melt-ui/svelte": ">=0.80.0",
		"svelte": ">=5.0.0",
		"tailwindcss": ">=4.0.0",
		"vite": ">=5.0.0"
	}
}
