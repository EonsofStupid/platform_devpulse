{
	"surface": {
		"$type": "color",
		"$description": "Surface fill intents",
		"primary":      { "$value": "{glass.void}" },
		"elevated":     { "$value": "{glass.smoke}" },
		"overlay":      { "$value": "{glass.deep}" },
		"frosted":      { "$value": "{glass.frost}" },
		"muted":        { "$value": "{matte.dark}" },
		"muted-medium": { "$value": "{matte.medium}" },
		"muted-light":  { "$value": "{matte.light}" }
	},
	"border": {
		"$type": "color",
		"$description": "Border color intents",
		"subtle": {
			"$value": { "colorSpace": "oklch", "components": [0.40, 0.13, 180], "alpha": 0.22, "hex": "#005c4a" },
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-700) l c h / 0.22)",
					"defaultValue": { "colorSpace": "oklch", "components": [0.40, 0.13, 180], "alpha": 0.22 }
				}
			}
		},
		"soft": {
			"$value": { "colorSpace": "oklch", "components": [0.48, 0.16, 180], "alpha": 0.30, "hex": "#007861" },
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-600) l c h / 0.30)",
					"defaultValue": { "colorSpace": "oklch", "components": [0.48, 0.16, 180], "alpha": 0.30 }
				}
			}
		},
		"emphasis": {
			"$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 180], "alpha": 0.50, "hex": "#009076" },
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-500) l c h / 0.50)",
					"defaultValue": { "colorSpace": "oklch", "components": [0.55, 0.18, 180], "alpha": 0.50 }
				}
			}
		},
		"focus":         { "$value": "{color.teal.400}" },
		"divider":       { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.06, "hex": "#ffffff" } },
		"divider-faint": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.04, "hex": "#ffffff" } }
	},
	"interaction": {
		"$type": "color",
		"$description": "Interactive state colors",
		"hover":    { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.06, "hex": "#ffffff" } },
		"active":   { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.10, "hex": "#ffffff" } },
		"selected": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.15, "hex": "#ffffff" } }
	},
	"overlay": {
		"$type": "color",
		"$description": "Overlay backdrop fills",
		"bg":       { "$value": { "colorSpace": "oklch", "components": [0.06, 0.02, 195], "alpha": 0.40, "hex": "#000404" } },
		"bg-heavy": { "$value": { "colorSpace": "oklch", "components": [0.06, 0.02, 195], "alpha": 0.60, "hex": "#000404" } }
	},
	"depth": {
		"$type": "shadow",
		"$description": "Semantic shadow elevation aliases",
		"flat":    { "$value": "{shadow.z0}" },
		"raised":  { "$value": "{shadow.z1}" },
		"panel":   { "$value": "{shadow.z2}" },
		"overlay": { "$value": "{shadow.z3}" },
		"modal":   { "$value": "{shadow.z4}" }
	},
	"transition": {
		"$type": "transition",
		"$description": "Semantic transition presets (duration + easing)",
		"instant": {
			"$value": {
				"duration": "{motion.duration.snap}",
				"timingFunction": "{motion.ease.out}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"fast": {
			"$value": {
				"duration": "{motion.duration.fast}",
				"timingFunction": "{motion.ease.out}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"normal": {
			"$value": {
				"duration": "{motion.duration.normal}",
				"timingFunction": "{motion.ease.inOut}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"slow": {
			"$value": {
				"duration": "{motion.duration.smooth}",
				"timingFunction": "{motion.ease.inOut}",
				"delay": { "value": 0, "unit": "ms" }
			}
		}
	},
	"backdrop": {
		"$type": "color",
		"$description": "Background glow and grid colors for page backdrops",
		"glow-teal":        { "$value": { "colorSpace": "oklch", "components": [0.15, 0.06, 180], "alpha": 0.30, "hex": "#001210" } },
		"glow-purple":      { "$value": { "colorSpace": "oklch", "components": [0.15, 0.08, 280], "alpha": 0.25, "hex": "#080015" } },
		"glow-purple-fade": { "$value": { "colorSpace": "oklch", "components": [0.10, 0.04, 180], "alpha": 0.10, "hex": "#000806" } },
		"glow-ember":       { "$value": { "colorSpace": "oklch", "components": [0.15, 0.07, 25], "alpha": 0.25, "hex": "#160303" } },
		"glow-cyber":       { "$value": { "colorSpace": "oklch", "components": [0.15, 0.06, 160], "alpha": 0.25, "hex": "#001108" } },
		"glow-magenta":     { "$value": { "colorSpace": "oklch", "components": [0.15, 0.07, 330], "alpha": 0.25, "hex": "#130010" } },
		"grid-teal":        { "$value": { "colorSpace": "oklch", "components": [0.20, 0.04, 180], "alpha": 0.08, "hex": "#001c17" } },
		"grid-purple":      { "$value": { "colorSpace": "oklch", "components": [0.22, 0.05, 280], "alpha": 0.06, "hex": "#0f0b20" } },
		"grid-ember":       { "$value": { "colorSpace": "oklch", "components": [0.20, 0.04, 25], "alpha": 0.06, "hex": "#1e0d09" } },
		"grid-cyber":       { "$value": { "colorSpace": "oklch", "components": [0.20, 0.04, 160], "alpha": 0.06, "hex": "#001b0e" } },
		"grid-magenta":     { "$value": { "colorSpace": "oklch", "components": [0.20, 0.04, 330], "alpha": 0.06, "hex": "#1c0a18" } }
	},
	"scrollbar": {
		"$type": "color",
		"$description": "Scrollbar thumb colors",
		"thumb":       { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.12, "hex": "#ffffff" } },
		"thumb-hover": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.20, "hex": "#ffffff" } }
	}
}
