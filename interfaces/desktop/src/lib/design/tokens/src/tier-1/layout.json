{
	"radius": {
		"$type": "dimension",
		"$description": "Border radius scale",
		"none": { "$value": { "value": 0, "unit": "px" } },
		"xs":   { "$value": { "value": 0.125, "unit": "rem" } },
		"sm":   { "$value": { "value": 0.25, "unit": "rem" } },
		"md":   { "$value": { "value": 0.5, "unit": "rem" } },
		"lg":   { "$value": { "value": 0.75, "unit": "rem" } },
		"xl":   { "$value": { "value": 1, "unit": "rem" } },
		"full": { "$value": { "value": 9999, "unit": "px" } }
	},
	"z": {
		"$type": "number",
		"$description": "Z-index stacking order",
		"base":     { "$value": 0 },
		"raised":   { "$value": 10 },
		"dropdown": { "$value": 100 },
		"sticky":   { "$value": 200 },
		"overlay":  { "$value": 300 },
		"modal":    { "$value": 400 },
		"popover":  { "$value": 500 },
		"toast":    { "$value": 600 },
		"tooltip":  { "$value": 700 }
	}
}
