{
	"radius": {
		"$description": "Border radius scale",
		"none": { "$type": "dimension", "$value": "0" },
		"xs":   { "$type": "dimension", "$value": "0.125rem" },
		"sm":   { "$type": "dimension", "$value": "0.25rem" },
		"md":   { "$type": "dimension", "$value": "0.5rem" },
		"lg":   { "$type": "dimension", "$value": "0.75rem" },
		"xl":   { "$type": "dimension", "$value": "1rem" },
		"full": { "$type": "dimension", "$value": "9999px" }
	},
	"z": {
		"$description": "Z-index stacking order",
		"base":     { "$type": "number", "$value": 0 },
		"raised":   { "$type": "number", "$value": 10 },
		"dropdown": { "$type": "number", "$value": 100 },
		"sticky":   { "$type": "number", "$value": 200 },
		"overlay":  { "$type": "number", "$value": 300 },
		"modal":    { "$type": "number", "$value": 400 },
		"popover":  { "$type": "number", "$value": 500 },
		"toast":    { "$type": "number", "$value": 600 },
		"tooltip":  { "$type": "number", "$value": 700 }
	}
}
