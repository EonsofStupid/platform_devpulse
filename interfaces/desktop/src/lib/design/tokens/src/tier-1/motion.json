{
	"motion": {
		"$description": "Motion tokens — non-interactive animations and timing primitives",
		"duration": {
			"$type": "duration",
			"$description": "Duration scale — used by transitions and animations",
			"snap":     { "$value": { "value": 50, "unit": "ms" } },
			"fast":     { "$value": { "value": 150, "unit": "ms" } },
			"normal":   { "$value": { "value": 250, "unit": "ms" } },
			"smooth":   { "$value": { "value": 400, "unit": "ms" } },
			"glacial":  { "$value": { "value": 700, "unit": "ms" } },
			"moderate": { "$value": { "value": 3, "unit": "s" } }
		},
		"ease": {
			"$type": "cubicBezier",
			"$description": "Easing / timing functions",
			"linear": { "$value": [0, 0, 1, 1] },
			"in":     { "$value": [0.4, 0, 1, 1] },
			"out":    { "$value": [0, 0, 0.2, 1] },
			"inOut":  { "$value": [0.4, 0, 0.2, 1] },
			"spring": { "$value": [0.34, 1.56, 0.64, 1] },
			"bounce": { "$value": [0.68, -0.55, 0.27, 1.55] }
		},
		"animation": {
			"$description": "Named animation shorthands — reference @keyframes. No DTCG type exists for CSS animations.",
			"pulse-glow": {
				"$value": "pulse-glow 4s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "pulse-glow", "iterationCount": "infinite" } }
			},
			"breathe": {
				"$value": "cl-breathe 4s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "cl-breathe", "iterationCount": "infinite" } }
			},
			"shimmer": {
				"$value": "cl-shimmer 8s linear infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "cl-shimmer", "iterationCount": "infinite" } }
			},
			"drift": {
				"$value": "cl-drift 8s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "cl-drift", "iterationCount": "infinite" } }
			},
			"pulse": {
				"$value": "cl-pulse 3s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "cl-pulse", "iterationCount": "infinite" } }
			},
			"fade-in": {
				"$value": "fade-in 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "fade-in", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"slide-up": {
				"$value": "slide-up 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "slide-up", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"slide-down": {
				"$value": "slide-down 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "slide-down", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"scale-in": {
				"$value": "scale-in 250ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "axis": "motion", "scope": "primitive", "keyframe": "scale-in", "iterationCount": 1, "fillMode": "forwards" } }
			}
		}
	}
}
