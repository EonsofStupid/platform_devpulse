{
	"duration": {
		"$description": "Transition duration scale",
		"snap":     { "$type": "duration", "$value": "50ms" },
		"fast":     { "$type": "duration", "$value": "150ms" },
		"normal":   { "$type": "duration", "$value": "250ms" },
		"smooth":   { "$type": "duration", "$value": "400ms" },
		"glacial":  { "$type": "duration", "$value": "700ms" },
		"moderate": { "$type": "duration", "$value": "3s" }
	},
	"ease": {
		"$description": "Easing / timing functions",
		"linear": { "$type": "cubicBezier", "$value": "linear" },
		"in":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" },
		"out":    { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)" },
		"inOut":  { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
		"spring": { "$type": "cubicBezier", "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)" },
		"bounce": { "$type": "cubicBezier", "$value": "cubic-bezier(0.68, -0.55, 0.27, 1.55)" }
	},
	"animation": {
		"$description": "Named animation shorthands — reference @keyframes",
		"pulse-glow":  { "$type": "other", "$value": "pulse-glow 4s ease-in-out infinite" },
		"breathe":     { "$type": "other", "$value": "cl-breathe 4s ease-in-out infinite" },
		"shimmer":     { "$type": "other", "$value": "cl-shimmer 8s linear infinite" },
		"drift":       { "$type": "other", "$value": "cl-drift 8s ease-in-out infinite" },
		"pulse":       { "$type": "other", "$value": "cl-pulse 3s ease-in-out infinite" },
		"fade-in":     { "$type": "other", "$value": "fade-in 300ms ease-out forwards" },
		"slide-up":    { "$type": "other", "$value": "slide-up 300ms ease-out forwards" },
		"slide-down":  { "$type": "other", "$value": "slide-down 300ms ease-out forwards" },
		"scale-in":    { "$type": "other", "$value": "scale-in 250ms ease-out forwards" }
	}
}
