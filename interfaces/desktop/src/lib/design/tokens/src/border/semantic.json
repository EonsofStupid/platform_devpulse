{
	"border": {
		"$type": "color",
		"$description": "Border color intents",
		"subtle": {
			"$value": { "colorSpace": "oklch", "components": [0.40, 0.13, 180], "alpha": 0.22, "hex": "#005c4a" },
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-700) l c h / 0.22)",
					"defaultValue": { "colorSpace": "oklch", "components": [0.40, 0.13, 180], "alpha": 0.22 }
				}
			}
		},
		"soft": {
			"$value": { "colorSpace": "oklch", "components": [0.48, 0.16, 180], "alpha": 0.30, "hex": "#007861" },
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-600) l c h / 0.30)",
					"defaultValue": { "colorSpace": "oklch", "components": [0.48, 0.16, 180], "alpha": 0.30 }
				}
			}
		},
		"emphasis": {
			"$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 180], "alpha": 0.50, "hex": "#009076" },
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-500) l c h / 0.50)",
					"defaultValue": { "colorSpace": "oklch", "components": [0.55, 0.18, 180], "alpha": 0.50 }
				}
			}
		},
		"focus":         { "$value": "{color.teal.400}" },
		"divider":       { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.06, "hex": "#ffffff" } },
		"divider-faint": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.04, "hex": "#ffffff" } }
	}
}
