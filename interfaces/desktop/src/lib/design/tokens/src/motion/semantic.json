{
	"transition": {
		"$type": "transition",
		"$description": "Semantic transition presets (duration + easing)",
		"instant": {
			"$value": {
				"duration": "{motion.duration.snap}",
				"timingFunction": "{motion.ease.out}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"fast": {
			"$value": {
				"duration": "{motion.duration.fast}",
				"timingFunction": "{motion.ease.out}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"normal": {
			"$value": {
				"duration": "{motion.duration.normal}",
				"timingFunction": "{motion.ease.inOut}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"slow": {
			"$value": {
				"duration": "{motion.duration.smooth}",
				"timingFunction": "{motion.ease.inOut}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"glacial": {
			"$value": {
				"duration": "{motion.duration.glacial}",
				"timingFunction": "{motion.ease.inOut}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"spring": {
			"$value": {
				"duration": "{motion.duration.normal}",
				"timingFunction": "{motion.ease.spring}",
				"delay": { "value": 0, "unit": "ms" }
			}
		},
		"bounce": {
			"$value": {
				"duration": "{motion.duration.smooth}",
				"timingFunction": "{motion.ease.bounce}",
				"delay": { "value": 0, "unit": "ms" }
			}
		}
	}
}
