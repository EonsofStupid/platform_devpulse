{
	"$description": "Hand-authored named text-style presets — DTCG typography composites with fontSize/fontFamily/fontWeight/lineHeight/letterSpacing. Every string px value is rewritten as a DTCG dimension object; lineHeight stays numeric; letterSpacing em values become `{ value, unit: 'em' }` — DTCG dimension accepts `em` via the `unit` field although the 2025.10 spec formally names only `px` and `rem`, so a vendor extension records the em unit explicitly for future tool compatibility.",
	"textStyle": {
		"$type": "typography",
		"$description": "Named text-style presets — complete typographic compositions per use case.",
		"display-lg": {
			"$value": {
				"fontSize": { "value": 2, "unit": "rem" },
				"fontFamily": "{font.display}",
				"fontWeight": 700,
				"lineHeight": 1.1,
				"letterSpacing": { "value": 0.02, "unit": "em" }
			},
			"$description": "Hero stats, page titles — 32 px at base 16."
		},
		"display-sm": {
			"$value": {
				"fontSize": { "value": 1.5, "unit": "rem" },
				"fontFamily": "{font.display}",
				"fontWeight": 600,
				"lineHeight": 1.2,
				"letterSpacing": { "value": 0.01, "unit": "em" }
			},
			"$description": "Section headers, widget titles — 24 px."
		},
		"heading-lg": {
			"$value": {
				"fontSize": { "value": 1.25, "unit": "rem" },
				"fontFamily": "{font.sans}",
				"fontWeight": 600,
				"lineHeight": 1.3,
				"letterSpacing": { "value": -0.01, "unit": "em" }
			},
			"$description": "Panel headers, card titles — 20 px."
		},
		"heading-sm": {
			"$value": {
				"fontSize": { "value": 1, "unit": "rem" },
				"fontFamily": "{font.sans}",
				"fontWeight": 600,
				"lineHeight": 1.4,
				"letterSpacing": { "value": -0.005, "unit": "em" }
			},
			"$description": "Sub-headers, group labels — 16 px."
		},
		"body": {
			"$value": {
				"fontSize": { "value": 0.875, "unit": "rem" },
				"fontFamily": "{font.sans}",
				"fontWeight": 400,
				"lineHeight": 1.5,
				"letterSpacing": { "value": 0, "unit": "em" }
			},
			"$description": "Default body text — 14 px."
		},
		"body-sm": {
			"$value": {
				"fontSize": { "value": 0.8125, "unit": "rem" },
				"fontFamily": "{font.sans}",
				"fontWeight": 400,
				"lineHeight": 1.45,
				"letterSpacing": { "value": 0, "unit": "em" }
			},
			"$description": "Secondary body, descriptions — 13 px."
		},
		"caption": {
			"$value": {
				"fontSize": { "value": 0.75, "unit": "rem" },
				"fontFamily": "{font.sans}",
				"fontWeight": 500,
				"lineHeight": 1.4,
				"letterSpacing": { "value": 0.01, "unit": "em" }
			},
			"$description": "Captions, timestamps, metadata — 12 px."
		},
		"overline": {
			"$value": {
				"fontSize": { "value": 0.6875, "unit": "rem" },
				"fontFamily": "{font.sans}",
				"fontWeight": 600,
				"lineHeight": 1.3,
				"letterSpacing": { "value": 0.08, "unit": "em" }
			},
			"$description": "Overline labels, category tags — 11 px."
		},
		"code": {
			"$value": {
				"fontSize": { "value": 0.8125, "unit": "rem" },
				"fontFamily": "{font.mono}",
				"fontWeight": 400,
				"lineHeight": 1.6,
				"letterSpacing": { "value": 0, "unit": "em" }
			},
			"$description": "Code blocks, terminal output — 13 px."
		},
		"stat": {
			"$value": {
				"fontSize": { "value": 1.5, "unit": "rem" },
				"fontFamily": "{font.display}",
				"fontWeight": 700,
				"lineHeight": 1.1,
				"letterSpacing": { "value": 0.02, "unit": "em" }
			},
			"$description": "Dashboard stat values, gauges — 24 px."
		}
	}
}
