		"presence-rest": {
			"$value": { "value": 6000, "unit": "ms" },
			"$description": "Presence orb — resting, slow desaturated breathing.",
			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-presence-rest", "easing": [0.4, 0, 0.2, 1], "iterationCount": "infinite" } } }
		},
		"presence-halo": {
			"$value": { "value": 3200, "unit": "ms" },
			"$description": "Presence orb — outer halo breathing, pairs with any core.",
			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-presence-halo", "easing": [0.4, 0, 0.2, 1], "iterationCount": "infinite" } } }
		},
		"presence-alert": {
			"$value": { "value": 900, "unit": "ms" },
			"$description": "Presence orb — alert, fast asymmetric pulse.",
			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-presence-alert", "easing": [0.4, 0, 0.2, 1], "iterationCount": "infinite" } } }
		}
	}
}
