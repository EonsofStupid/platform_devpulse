			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-presence-pulse", "easing": [0.4, 0, 0.2, 1], "iterationCount": "infinite" } } }
		},
		"presence-think": {
			"$value": { "value": 2400, "unit": "ms" },
			"$description": "Presence orb — thinking, rotate+hue-shift.",
			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-presence-think", "easing": [0, 0, 1, 1], "iterationCount": "infinite" } } }
		},
		"presence-listen": {
			"$value": { "value": 1600, "unit": "ms" },
			"$description": "Presence orb — listening, squash/stretch attentive.",
