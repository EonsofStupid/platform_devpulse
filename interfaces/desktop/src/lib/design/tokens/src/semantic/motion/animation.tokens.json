			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-float", "easing": [0.4, 0, 0.2, 1], "iterationCount": "infinite" } } }
		},
		"flip": {
			"$value": { "value": 600, "unit": "ms" },
