			"$extensions": { "com.devpulse.coldlight": { "animation": { "keyframe": "cl-flip", "easing": [0.4, 0, 0.2, 1], "iterationCount": 1, "fillMode": "forwards" } } }
		},
		"presence-breathe": {
			"$value": { "value": 3200, "unit": "ms" },
