	"text": {
		"$type": "color",
		"$description": "Text color tokens — semantic text hierarchy",
		"primary":   { "$value": { "colorSpace": "oklch", "components": [0.95, 0.01, 220], "hex": "#e8f0f3" } },
		"secondary": { "$value": { "colorSpace": "oklch", "components": [0.72, 0.02, 220], "hex": "#98a8ad" } },
		"muted":     { "$value": { "colorSpace": "oklch", "components": [0.50, 0.02, 220], "hex": "#57666b" } },
		"disabled":  { "$value": { "colorSpace": "oklch", "components": [0.35, 0.01, 220], "hex": "#353c3e" } },
		"accent":    { "$value": { "colorSpace": "oklch", "components": [0.75, 0.14, 180], "hex": "#00cab1" } },
		"inverse":   { "$value": { "colorSpace": "oklch", "components": [0.10, 0.01, 220], "hex": "#010405" } }
