{
	"bevel": {
		"$type": "shadow",
		"$description": "Neumorphic inset shadow treatments",
		"off": {
			"$value": {
				"color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 },
				"offsetX": { "value": 0, "unit": "px" },
				"offsetY": { "value": 0, "unit": "px" },
				"blur": { "value": 0, "unit": "px" },
				"spread": { "value": 0, "unit": "px" }
			},
			"$extensions": { "com.coldlight": { "inset": true, "axis": "bevel", "scope": "primitive" } }
		},
		"subtle": {
			"$value": [
				{
					"color": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.04 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": 1, "unit": "px" },
					"blur": { "value": 0, "unit": "px" },
					"spread": { "value": 0, "unit": "px" }
				},
				{
					"color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": -1, "unit": "px" },
					"blur": { "value": 0, "unit": "px" },
					"spread": { "value": 0, "unit": "px" }
				}
			],
			"$extensions": { "com.coldlight": { "inset": true, "axis": "bevel", "scope": "primitive" } }
		},
		"soft": {
			"$value": [
				{
					"color": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.06 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": 1, "unit": "px" },
					"blur": { "value": 2, "unit": "px" },
					"spread": { "value": 0, "unit": "px" }
				},
				{
					"color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": -1, "unit": "px" },
					"blur": { "value": 2, "unit": "px" },
					"spread": { "value": 0, "unit": "px" }
				}
			],
			"$extensions": { "com.coldlight": { "inset": true, "axis": "bevel", "scope": "primitive" } }
		},
		"medium": {
			"$value": [
				{
					"color": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.08 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": 2, "unit": "px" },
					"blur": { "value": 4, "unit": "px" },
					"spread": { "value": 0, "unit": "px" }
				},
				{
					"color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.16 },
					"offsetX": { "value": 0, "unit": "px" },
					"offsetY": { "value": -2, "unit": "px" },
					"blur": { "value": 4, "unit": "px" },
					"spread": { "value": 0, "unit": "px" }
				}
			],
			"$extensions": { "com.coldlight": { "inset": true, "axis": "bevel", "scope": "primitive" } }
		}
	}
}
