{
	"$description": "Button's tokens (plan 0006 §0s). The build generates styles/components/kinds/button.css and button.generated.ts from the button group.",
	"button": {
		"$description": "Each variant is a family role plus Button's differences. Sizes own the label type (the class map's text-sm/text-base and font-medium). Values reproduce what Button rendered before 0s.4b.",
		"$extensions": {
			"com.coldlight": {
				"accepts": ["surface", "text", "frame", "interactive"],
				"defaults": { "variant": "primary", "size": "md" },
				"unused": {
					"note": "Hand-made looks no Button rendered: renderForge never read them (PL-007). Kept as data, not emitted; a look moves into a section only with the owner's OK, and state colours come from 0b.3's interaction tokens. primary-hover and primary-active are the app.css shim's palette form of their hue-180 originals.",
					"destructive": {
						"background-color": "oklch(0.45 0.18 25)",
						"border-radius": "0.5rem",
						"box-shadow": "0 0 1rem 0 oklch(0.5 0.2 25 / 0.3)",
						"color": "oklch(0.97 0.01 25)",
						"border-color": "oklch(0.55 0.2 25 / 0.4)",
						"border-width": "0.0625rem",
						"backdrop-filter": "none",
						"opacity": "1",
						"animation": "none",
						"transition-duration": "150ms",
						"transition-timing-function": "cubic-bezier(0, 0, 0.2, 1)",
						"gradient": "none",
						"font-family": "{font.sans}",
						"font-size": "0.875rem",
						"font-weight": "600",
						"letter-spacing": "0.01em",
						"line-height": "1.5",
						"background-image": "none",
						"background-alpha": "1"
					},
					"destructive-hover": {
						"background-color": "oklch(0.4 0.17 25)",
						"box-shadow": "0 0 1.5rem 0.125rem oklch(0.5 0.2 25 / 0.45)"
					},
					"primary-hover": {
						"background-color": "color-mix(in oklch, {primary.main} 82%, black 12%)",
						"box-shadow": "0 0 1.5rem 0.125rem {primary.glow}",
						"border-color": "color-mix(in oklch, {primary.main} 78%, transparent)"
					},
					"primary-active": {
						"background-color": "color-mix(in oklch, {primary.main} 66%, black 28%)"
					},
					"primary-disabled": {
						"opacity": "0.35"
					},
					"secondary-hover": {
						"background-color": "oklch(0.25 0.015 240)"
					},
					"ghost-hover": {
						"background-color": "oklch(0.2 0.01 240 / 0.5)",
						"color": "oklch(0.88 0.01 240)"
					}
				}
			}
		},
		"base": {
			"border-style": { "$value": "solid", "$type": "strokeStyle" }
		},
		"variant": {
			"primary": {
				"$description": "Glass Deep with the primary role's colour (formerly the app.css shim over hue-180 literals).",
				"$extends": "{preset.glass-deep}",
				"background-color": { "$value": "{primary.main}", "$type": "color" },
				"border-color": {
					"$value": "color-mix(in oklch, {primary.main} 60%, transparent)",
					"$type": "color"
				},
				"box-shadow": { "$value": "0 0 1rem 0 {primary.glow}", "$type": "shadow" },
				"color": { "$value": "oklch(0.97 0.01 180)", "$type": "color" },
				"border-radius": { "$value": "0.5rem", "$type": "dimension" },
				"letter-spacing": { "$value": "0.01em", "$type": "dimension" },
				"transition-duration": { "$value": "150ms", "$type": "duration" },
				"transition-timing-function": {
					"$value": "cubic-bezier(0, 0, 0.2, 1)",
					"$type": "cubicBezier"
				}
			},
			"secondary": {
				"$description": "Neuro Minimal, lifted and squared off for an action.",
				"$extends": "{preset.neuro-minimal}",
				"background-color": { "$value": "{matte.medium}", "$type": "color" },
				"border-color": { "$value": "{matte.light}", "$type": "color" },
				"box-shadow": { "$value": "0 0 0.5rem 0 oklch(0 0 0 / 0.3)", "$type": "shadow" },
				"color": { "$value": "oklch(0.8 0.01 240)", "$type": "color" },
				"transition-duration": { "$value": "150ms", "$type": "duration" },
				"transition-timing-function": {
					"$value": "cubic-bezier(0, 0, 0.2, 1)",
					"$type": "cubicBezier"
				}
			},
			"ghost": {
				"$description": "Flat Minimal: no fill, no border, muted label.",
				"$extends": "{preset.flat-minimal}",
				"background-color": { "$value": "oklch(0 0 0 / 0)", "$type": "color" },
				"border-color": { "$value": "oklch(0 0 0 / 0)", "$type": "color" },
				"color": { "$value": "oklch(0.65 0.01 240)", "$type": "color" },
				"border-radius": { "$value": "0.5rem", "$type": "dimension" },
				"transition-duration": { "$value": "150ms", "$type": "duration" },
				"transition-timing-function": {
					"$value": "cubic-bezier(0, 0, 0.2, 1)",
					"$type": "cubicBezier"
				}
			},
			"danger": {
				"$description": "Stark Glow as it is, pulse included.",
				"$extends": "{preset.stark-glow}"
			}
		},
		"size": {
			"sm": {
				"height": { "$value": "2rem", "$type": "dimension" },
				"padding-inline": { "$value": "0.75rem", "$type": "dimension" },
				"gap": { "$value": "0.375rem", "$type": "dimension" },
				"font-size": { "$value": "0.875rem", "$type": "dimension" },
				"line-height": { "$value": "1.25rem", "$type": "dimension" },
				"font-weight": { "$value": 500, "$type": "fontWeight" }
			},
			"md": {
				"height": { "$value": "2.5rem", "$type": "dimension" },
				"padding-inline": { "$value": "1rem", "$type": "dimension" },
				"gap": { "$value": "0.5rem", "$type": "dimension" },
				"font-size": { "$value": "0.875rem", "$type": "dimension" },
				"line-height": { "$value": "1.25rem", "$type": "dimension" },
				"font-weight": { "$value": 500, "$type": "fontWeight" }
			},
			"lg": {
				"height": { "$value": "3rem", "$type": "dimension" },
				"padding-inline": { "$value": "1.5rem", "$type": "dimension" },
				"gap": { "$value": "0.625rem", "$type": "dimension" },
				"font-size": { "$value": "1rem", "$type": "dimension" },
				"line-height": { "$value": "1.5rem", "$type": "dimension" },
				"font-weight": { "$value": 500, "$type": "fontWeight" }
			}
		},
		"state": {
			"disabled": {
				"$description": "The dimming Button.svelte's disabled:opacity-50 meant; it never matched, since useButton marks disabled with aria-disabled and data-disabled, not the disabled attribute.",
				"opacity": { "$value": 0.5, "$type": "number" }
			}
		}
	}
}
