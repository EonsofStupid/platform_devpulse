{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "paths": {
            "$lib/*": [
                "./lib/*"
            ]
        }
    },
    "include": [
        "**/*.d.ts",
        "**/*.ts",
        "**/*.js",
        "**/*.svelte"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules",
        "**/lib/design/primitives/_archive/**"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}