{
	"$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["warn", "error"]
					}
				}
			},
			"style": {
				"useImportType": "error",
				"useConst": "error",
				"useFilenamingConvention": {
					"level": "warn",
					"options": {
						"filenameCases": ["camelCase", "PascalCase", "kebab-case"]
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/*.ts", "scripts/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/UIDemoPage.svelte", "**/DEBUG_FLAG.ts", "**/VPB.svelte"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/dist",
			"!**/build",
			"!**/*.generated.*",
			"!**/src/lib/sys/generated",
			"!**/src/lib/design/.cowlevel",
			"!**/src/lib/design/tokens/tokens.css",
			"!**/src/lib/design/tokens/types.ts",
			"!**/src/lib/design/tokens/tailwind.preset.ts",
			"!**/src/lib/design/primitives/_archive",
			"!**/src/lib/design/primitives/tanstack/flex-render.svelte",
			"!**/src-tauri/gen",
			"!**/taxonomy/.generated/coldlight.manifest.json"
		]
	}
}
