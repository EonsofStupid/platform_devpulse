{
	"$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",
	"extends": "//",
	"overrides": [
		{
			"includes": ["**/DEBUG_FLAG.ts"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/sys/debug/vpb/**"],
			"linter": {
				"rules": {
					"nursery": {
						"noHexColors": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"!**/src/lib/sys/generated",
			"!**/src-tauri/resources/devforge",
			"!**/src-tauri/gen"
		]
	}
}
