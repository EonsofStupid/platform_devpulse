{
	"$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",
	"plugins": [
		"./gritql/no-raw-colors.grit",
		"./gritql/no-raw-colors-bg.grit",
		"./gritql/no-named-colors.grit",
		"./gritql/no-raw-px-padding.grit",
		"./gritql/no-raw-px-margin.grit",
		"./gritql/no-raw-px-gap.grit",
		"./gritql/no-raw-px-width.grit",
		"./gritql/no-raw-px-height.grit",
		"./gritql/no-raw-px-font-size.grit",
		"./gritql/no-raw-px-border-radius.grit"
	],
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"nursery": {
				"noHexColors": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["warn", "error"]
					}
				}
			},
			"style": {
				"useImportType": "error",
				"useConst": "error",
				"useFilenamingConvention": {
					"level": "warn",
					"options": {
						"filenameCases": ["camelCase", "PascalCase", "kebab-case"]
					}
				},
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {},
						"patterns": [
							{
								"group": ["**/_archive/*", "**/_archive/**"],
								"message": "Archive imports are banned. Build from taxonomy contracts."
							}
						]
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/*.ts", "scripts/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/routes/**/+page.svelte",
				"src/routes/**/+page.ts",
				"src/routes/**/+page.server.ts",
				"src/routes/**/+layout.svelte",
				"src/routes/**/+layout.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {},
								"patterns": [
									{
										"group": ["**/_archive/*", "**/_archive/**"],
										"message": "Archive imports are banned. Build from taxonomy contracts."
									},
									{
										"group": ["$lib/design/recipes/*", "$lib/design/recipes/**"],
										"message": "Routes must not import recipes directly. Use components or renderers."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/design/builders/**/*.ts", "src/lib/design/builders/**/*.svelte.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@melt-ui/svelte": "builders/ must not import third-party headless libraries. ColdLight-owned only.",
									"@melt-ui/svelte/internal/helpers": "builders/ must not import third-party headless internals."
								},
								"patterns": [
									{
										"group": ["**/_archive/*", "**/_archive/**"],
										"message": "Archive imports are banned. Build from taxonomy contracts."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/test-components/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/UIDemoPage.svelte", "**/DEBUG_FLAG.ts", "**/VPB.svelte"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/lib/design/styles/**",
				"src/lib/design/css/**",
				"src/lib/design/theme/**",
				"src/lib/design/generated/**",
				"src/lib/design/svg/**",
				"src/lib/design/plugins/**",
				"src/lib/sys/debug/vpb/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noHexColors": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/dist",
			"!**/build",
			"!**/*.generated.*",
			"!**/src/lib/sys/generated",
			"!**/src/lib/design/.cowlevel",
			"!**/src/lib/design/style",
			"!**/src/lib/design/styles",
			"!**/src/lib/design/css",
			"!**/src/lib/design/theme",
			"!**/src/lib/design/generated",
			"!**/src/lib/design/svg",
			"!**/src/lib/design/plugins",
			"!**/src/lib/design/primitives/_archive",
			"!**/src/lib/design/primitives/tanstack/flex-render.svelte",
			"!**/src-tauri/resources/devforge",
			"!**/src-tauri/gen",
			"!**/taxonomy/.generated/coldlight.manifest.json"
		]
	}
}
