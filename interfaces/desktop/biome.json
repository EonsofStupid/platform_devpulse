{
	"$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",
	"extends": "//",
	"overrides": [
		{
			"includes": [
				"src/routes/**/+page.svelte",
				"src/routes/**/+page.ts",
				"src/routes/**/+page.server.ts",
				"src/routes/**/+layout.svelte",
				"src/routes/**/+layout.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {},
								"patterns": [
									{
										"group": ["**/_archive/*", "**/_archive/**"],
										"message": "Archive imports are banned. Build from taxonomy contracts."
									},
									{
										"group": [
											"$lib/design/recipes/*",
											"$lib/design/recipes/**",
											"@devpulse/coldlight/recipes/*",
											"@devpulse/coldlight/recipes/**"
										],
										"message": "Routes must not import recipes directly. Use components or renderers."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/test-components/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/UIDemoPage.svelte", "**/DEBUG_FLAG.ts", "**/VPB.svelte"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/sys/debug/vpb/**"],
			"linter": {
				"rules": {
					"nursery": {
						"noHexColors": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"!**/src/lib/sys/generated",
			"!**/src-tauri/resources/devforge",
			"!**/src-tauri/gen"
		]
	}
}
