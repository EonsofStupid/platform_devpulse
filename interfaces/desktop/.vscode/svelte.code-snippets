    "Svelte Primitive Component": {
        "scope": "svelte",
        "prefix": [
            "primitive",
            "prim"
        ],
        "body": [
            "<!--",
            "  @file ${TM_FILEPATH/.*src\\/lib\\/(.*)$/$1/}",
            "  @layer primitives",
            "  @aria ${1|button,tab,dialog,popover,menu|}",
            "",
            "  ${2:Headless component description}. Uses MeltUI for behavior.",
            "",
            "  Props:",
            "  - variant: ${3:\"default\" | \"primary\"} - Visual variant",
            "  - size: ${4:\"sm\" | \"md\" | \"lg\"} - Size variant",
            "",
            "  @vpb-editable variant, size",
            "  @consumers compositions/*, domains/*",
            "  @since 1.0.0",
            "-->",
            "<script lang=\"ts\">",
            "  import type { Snippet } from 'svelte';",
            "",
            "  interface Props {",
            "    variant?: ${3};",
            "    size?: ${4};",
            "    class?: string;",
            "    children: Snippet;",
            "  }",
            "",
            "  let {",
            "    variant = 'default',",
            "    size = 'md',",
            "    class: className = '',",
            "    children,",
            "  }: Props = \\$props();",
            "",
            "  // Token maps",
            "  const variantMap = {",
            "    default: 'var(--dp-surface-default)',",
            "    primary: 'var(--dp-surface-primary)',",
            "  };",
            "",
            "  const sizeMap = {",
            "    sm: 'var(--dp-space-2)',",
            "    md: 'var(--dp-space-4)',",
            "    lg: 'var(--dp-space-6)',",
            "  };",
            "</script>",
            "",
            "<div",
            "  class=\"${5:component-name} {className}\"",
            "  data-variant={variant}",
            "  data-size={size}",
            "  style:--variant-bg={variantMap[variant]}",
            "  style:--size-padding={sizeMap[size]}",
            ">",
            "  {@render children()}",
            "</div>",
            "",
            "$0"
        ],
        "description": "Create COLD LIGHT primitive component scaffold"
    }
}