		"border-active":{ "$type": "color", "$value": "{color.mint.600}", "$extensions": { "com.coldlight": { "alpha": 0.4 } } },
		"code-bg":      { "$type": "color", "$value": "{interaction.hover}" },
		"code-border":  { "$type": "color", "$value": "{interaction.hover}" },
