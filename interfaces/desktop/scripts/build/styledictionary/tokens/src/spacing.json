{
	"space": {
		"$type": "dimension",
		"$description": "Base spacing scale (px → rem via SD5 transform)",
		"1": { "$value": "4px" },
		"2": { "$value": "8px" },
		"3": { "$value": "12px" },
		"4": { "$value": "16px" },
		"5": { "$value": "20px" },
		"6": { "$value": "24px" },
		"8": { "$value": "32px" }
	},
	"padding": {
		"$type": "dimension",
		"$description": "Component padding presets (px → rem via SD5 transform)",
		"sm-y": { "$value": "6px" },
		"sm-x": { "$value": "12px" },
		"md-y": { "$value": "8px" },
		"md-x": { "$value": "16px" },
		"lg-y": { "$value": "12px" },
		"lg-x": { "$value": "24px" }
	},
	"size": {
		"$type": "dimension",
