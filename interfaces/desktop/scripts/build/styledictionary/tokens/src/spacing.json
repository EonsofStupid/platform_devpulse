{
	"space": {
		"$type": "dimension",
		"$description": "Base spacing scale (px → rem via SD5). Full range from hairline to max section spacing. Supports fluid clamp() across all breakpoints 320px–1536px.",
		"0":   { "$value": "0px",   "$description": "Zero — reset" },
		"1":   { "$value": "1px",   "$description": "Hairline — grid lines, single-pixel borders" },
		"2":   { "$value": "2px",   "$description": "Micro — tight label margins, outline offsets" },
		"3":   { "$value": "3px",   "$description": "Tight — compact padding, scrollbar radius" },
		"4":   { "$value": "4px",   "$description": "Base unit" },
		"5":   { "$value": "5px",   "$description": "Compact — small button padding" },
		"6":   { "$value": "6px",   "$description": "Snug — scrollbar width, tight gaps" },
		"7":   { "$value": "7px" },
		"8":   { "$value": "8px",   "$description": "Standard gap" },
		"9":   { "$value": "9px" },
		"10":  { "$value": "10px",  "$description": "Comfortable — button padding" },
		"11":  { "$value": "11px" },
		"12":  { "$value": "12px",  "$description": "Card padding sm" },
		"14":  { "$value": "14px" },
		"16":  { "$value": "16px",  "$description": "Card padding md, standard section gap" },
		"18":  { "$value": "18px" },
		"20":  { "$value": "20px",  "$description": "Panel padding" },
		"24":  { "$value": "24px",  "$description": "Section padding sm" },
		"28":  { "$value": "28px",  "$description": "Neural grid spacing" },
		"32":  { "$value": "32px",  "$description": "Section padding md" },
		"36":  { "$value": "36px",  "$description": "Maestro grid spacing" },
		"40":  { "$value": "40px",  "$description": "Toolbar height, default grid spacing" },
		"44":  { "$value": "44px",  "$description": "DevForge grid spacing" },
		"48":  { "$value": "48px",  "$description": "Section padding lg" },
		"56":  { "$value": "56px",  "$description": "Hero spacing sm" },
		"64":  { "$value": "64px",  "$description": "Hero spacing md" },
		"72":  { "$value": "72px" },
		"80":  { "$value": "80px",  "$description": "Hero spacing lg" },
		"96":  { "$value": "96px",  "$description": "Section max spacing" },
		"112": { "$value": "112px" },
		"128": { "$value": "128px", "$description": "Page-level max spacing" }
	},
	"padding": {
		"$type": "dimension",
		"$description": "Component padding presets (reference space tokens)",
		"xs-y": { "$value": "{space.4}" },
		"xs-x": { "$value": "{space.8}" },
		"sm-y": { "$value": "{space.6}" },
		"sm-x": { "$value": "{space.12}" },
		"md-y": { "$value": "{space.8}" },
		"md-x": { "$value": "{space.16}" },
		"lg-y": { "$value": "{space.12}" },
		"lg-x": { "$value": "{space.24}" },
		"xl-y": { "$value": "{space.16}" },
		"xl-x": { "$value": "{space.32}" },
		"2xl-y": { "$value": "{space.24}" },
		"2xl-x": { "$value": "{space.48}" }
	},
	"size": {
		"$type": "dimension",
		"$description": "Component and container size scale (px → rem via SD5). From icon size to full-width containers.",
		"3xs":  { "$value": "16px",   "$description": "Icon sm" },
		"2xs":  { "$value": "20px",   "$description": "Icon md" },
		"xs":   { "$value": "24px",   "$description": "Icon lg, badge" },
		"sm":   { "$value": "32px",   "$description": "Button sm, avatar sm" },
		"md":   { "$value": "40px",   "$description": "Button md, input height" },
		"lg":   { "$value": "48px",   "$description": "Button lg, avatar lg" },
		"xl":   { "$value": "56px",   "$description": "Toolbar height" },
		"2xl":  { "$value": "64px",   "$description": "Panel header" },
		"3xl":  { "$value": "80px",   "$description": "Card hero" },
		"4xl":  { "$value": "96px",   "$description": "Avatar xl" },
		"5xl":  { "$value": "128px",  "$description": "Feature block" },
		"container-xs":  { "$value": "320px",  "$description": "Mobile min" },
		"container-sm":  { "$value": "640px",  "$description": "Tablet" },
		"container-md":  { "$value": "768px",  "$description": "Tablet landscape" },
		"container-lg":  { "$value": "1024px", "$description": "Desktop" },
		"container-xl":  { "$value": "1280px", "$description": "Desktop wide" },
		"container-2xl": { "$value": "1536px", "$description": "Desktop max" }
	},
	"breakpoint": {
		"$type": "dimension",
		"$description": "Viewport breakpoints for fluid clamp() calculations",
		"xs":  { "$value": "320px",  "$description": "Mobile portrait" },
		"sm":  { "$value": "640px",  "$description": "Mobile landscape / small tablet" },
		"md":  { "$value": "768px",  "$description": "Tablet portrait" },
		"lg":  { "$value": "1024px", "$description": "Tablet landscape / desktop" },
		"xl":  { "$value": "1280px", "$description": "Desktop" },
		"2xl": { "$value": "1536px", "$description": "Wide desktop" }
	},
	"zIndex": {
		"$type": "number",
		"$description": "Z-index stacking order",
		"base":     { "$value": 0 },
		"raised":   { "$value": 10 },
		"dropdown": { "$value": 100 },
		"sticky":   { "$value": 200 },
		"overlay":  { "$value": 300 },
		"modal":    { "$value": 400 },
		"popover":  { "$value": 500 },
		"toast":    { "$value": 600 },
		"tooltip":  { "$value": 700 }
	}
}
