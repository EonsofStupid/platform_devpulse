{
	"$description": "ColdLight keyframe geometry — the SSOT for every @keyframes block. Each entry is a step map (offset → declarations) under the custom `keyframes` type; the coldlight/keyframes format emits them verbatim into generated/keyframes.generated.css. Animation metadata (duration/easing/iteration) lives beside this in animation.tokens.json. Names are prefixed `cl-` to stay collision-free across projects (a few legacy unprefixed names are kept for existing consumers).",
	"keyframes": {
		"$type": "keyframes",
		"pulse-glow": {
			"$description": "Pulsing glow — infinite ambient highlight.",
			"$value": {
				"0%, 100%": { "opacity": "1" },
				"50%": { "opacity": "0.6" }
			}
		},
		"cl-breathe": {
			"$description": "Breathing scale — infinite ambient pulse.",
			"$value": {
				"0%, 100%": { "opacity": "1", "transform": "scale(1)" },
				"50%": { "opacity": "0.85", "transform": "scale(0.98)" }
			}
		},
		"cl-shimmer": {
			"$description": "Shimmer loading placeholder — linear infinite.",
			"$value": {
				"0%": { "background-position": "-200% 0" },
				"100%": { "background-position": "200% 0" }
			}
		},
		"cl-drift": {
			"$description": "Drifting parallax — infinite ambient.",
			"$value": {
				"0%, 100%": { "transform": "translateY(0) translateX(0)" },
				"25%": { "transform": "translateY(-2px) translateX(1px)" },
				"50%": { "transform": "translateY(-4px) translateX(-1px)" },
				"75%": { "transform": "translateY(-2px) translateX(2px)" }
			}
		},
		"cl-pulse": {
			"$description": "Pulse — infinite attention indicator.",
			"$value": {
				"0%, 100%": { "box-shadow": "0 0 0 0 currentColor" },
				"50%": { "box-shadow": "0 0 12px 4px currentColor" }
			}
		},
		"fade-in": {
			"$description": "Fade in on mount — one-shot.",
			"$value": {
				"from": { "opacity": "0" },
				"to": { "opacity": "1" }
			}
		},
		"slide-up": {
			"$description": "Slide up on mount — one-shot.",
			"$value": {
				"from": { "transform": "translateY(4px)", "opacity": "0" },
				"to": { "transform": "translateY(0)", "opacity": "1" }
			}
		},
		"slide-down": {
			"$description": "Slide down on mount — one-shot.",
			"$value": {
				"from": { "transform": "translateY(-4px)", "opacity": "0" },
				"to": { "transform": "translateY(0)", "opacity": "1" }
			}
		},
		"scale-in": {
			"$description": "Scale in on mount — one-shot.",
			"$value": {
				"from": { "transform": "scale(0.95)", "opacity": "0" },
				"to": { "transform": "scale(1)", "opacity": "1" }
			}
		},
		"cl-spin": {
			"$description": "Continuous rotation.",
			"$value": {
				"from": { "transform": "rotate(0deg)" },
				"to": { "transform": "rotate(360deg)" }
			}
		},
		"cl-grow": {
			"$description": "Grow transition — ColdLight variant of scale-in.",
			"$value": {
				"from": { "transform": "scale(0.8)", "opacity": "0" },
				"to": { "transform": "scale(1)", "opacity": "1" }
			}
		},
		"cl-shrink": {
			"$description": "Shrink transition — ColdLight variant of scale-out.",
			"$value": {
				"from": { "transform": "scale(1)", "opacity": "1" },
				"to": { "transform": "scale(0.8)", "opacity": "0" }
			}
		},
		"cl-shake": {
			"$description": "Horizontal shake — error / invalid feedback.",
			"$value": {
				"0%, 100%": { "transform": "translateX(0)" },
				"10%, 50%, 90%": { "transform": "translateX(-0.25rem)" },
				"30%, 70%": { "transform": "translateX(0.25rem)" }
			}
		},
		"cl-float": {
			"$description": "Gentle vertical float — infinite ambient.",
			"$value": {
				"0%, 100%": { "transform": "translateY(0)" },
				"50%": { "transform": "translateY(-0.5rem)" }
			}
		},
		"cl-flip": {
			"$description": "3D flip in on mount — one-shot.",
			"$value": {
				"from": { "transform": "perspective(25rem) rotateY(90deg)", "opacity": "0" },
				"to": { "transform": "perspective(25rem) rotateY(0)", "opacity": "1" }
			}
		},
		"cl-glow-pulse": {
			"$description": "Preset family — pulsing glow halo + border.",
			"$value": {
				"0%, 100%": {
					"box-shadow": "0 0 0.5rem 0 oklch(0.7 0.15 180 / 0.15)",
					"border-color": "oklch(0.7 0.15 180 / 0.3)"
				},
				"50%": {
					"box-shadow": "0 0 1rem 0.125rem oklch(0.7 0.15 180 / 0.25)",
					"border-color": "oklch(0.7 0.15 180 / 0.45)"
				}
			}
		},
		"cl-crt-flicker": {
			"$description": "Preset family — subtle CRT opacity flicker.",
			"$value": {
				"0%, 100%": { "opacity": "1" },
				"50%": { "opacity": "0.97" }
			}
		},
		"cl-scanline": {
			"$description": "Preset family — vertical scanline sweep.",
			"$value": {
				"0%": { "background-position": "0 0" },
				"100%": { "background-position": "0 100%" }
			}
		},
		"cl-neon-buzz": {
			"$description": "Preset family — neon text buzz.",
			"$value": {
				"0%, 100%": { "opacity": "1", "text-shadow": "0 0 0.25rem currentColor" },
				"33%": { "opacity": "0.95", "text-shadow": "0 0 0.375rem currentColor" },
				"66%": { "opacity": "0.98", "text-shadow": "0 0 0.1875rem currentColor" }
			}
		},
		"cl-specular-sweep": {
			"$description": "Preset family — specular highlight sweep.",
			"$value": {
				"0%": { "background-position": "-100% 0" },
				"100%": { "background-position": "200% 0" }
			}
		},
		"cl-alert-pulse": {
			"$description": "Preset family — danger pulse halo + border.",
			"$value": {
				"0%, 100%": {
					"box-shadow": "0 0 0 0 oklch(0.65 0.22 25 / 0.2)",
					"border-color": "oklch(0.65 0.22 25 / 0.5)"
				},
				"50%": {
					"box-shadow": "0 0 1rem 0.25rem oklch(0.65 0.22 25 / 0.35)",
					"border-color": "oklch(0.65 0.22 25 / 0.7)"
				}
			}
		},
		"cl-presence-breathe": {
			"$description": "Presence — ambient breathing (container halo).",
			"$value": {
				"0%, 100%": { "transform": "scale(1)", "filter": "brightness(1) saturate(1)" },
				"50%": { "transform": "scale(1.06)", "filter": "brightness(1.12) saturate(1.08)" }
			}
		},
		"cl-presence-pulse": {
			"$description": "Presence — active pulse (inner core).",
			"$value": {
				"0%, 100%": { "transform": "scale(0.96)", "filter": "brightness(0.95)" },
				"50%": { "transform": "scale(1.12)", "filter": "brightness(1.3)" }
			}
		},
		"cl-presence-think": {
			"$description": "Presence — thinking rotation + hue drift.",
			"$value": {
				"0%": { "transform": "scale(1) rotate(0deg)", "filter": "hue-rotate(0deg) brightness(1)" },
				"33%": { "transform": "scale(1.05) rotate(120deg)", "filter": "hue-rotate(20deg) brightness(1.15)" },
				"66%": { "transform": "scale(0.98) rotate(240deg)", "filter": "hue-rotate(-15deg) brightness(1.05)" },
				"100%": { "transform": "scale(1) rotate(360deg)", "filter": "hue-rotate(0deg) brightness(1)" }
			}
		},
		"cl-presence-listen": {
			"$description": "Presence — listening non-uniform scale.",
			"$value": {
				"0%, 100%": { "transform": "scale(1, 1)", "filter": "brightness(1)" },
				"35%": { "transform": "scale(0.94, 1.12)", "filter": "brightness(1.2)" },
				"70%": { "transform": "scale(1.02, 0.96)", "filter": "brightness(1.05)" }
			}
		},
		"cl-presence-rest": {
			"$description": "Presence — resting dim breathing.",
			"$value": {
				"0%, 100%": { "transform": "scale(1)", "filter": "brightness(0.85) saturate(0.75)" },
				"50%": { "transform": "scale(1.02)", "filter": "brightness(0.92) saturate(0.8)" }
			}
		},
		"cl-presence-halo": {
			"$description": "Presence — halo opacity + scale.",
			"$value": {
				"0%, 100%": { "opacity": "0.55", "transform": "scale(1)" },
				"50%": { "opacity": "0.85", "transform": "scale(1.08)" }
			}
		},
		"cl-presence-alert": {
			"$description": "Presence — alert double-pulse.",
			"$value": {
				"0%, 100%": { "transform": "scale(1)", "filter": "brightness(1) saturate(1.2)" },
				"25%": { "transform": "scale(1.1)", "filter": "brightness(1.35) saturate(1.4)" },
				"50%": { "transform": "scale(0.96)", "filter": "brightness(0.95) saturate(1.1)" },
				"75%": { "transform": "scale(1.08)", "filter": "brightness(1.3) saturate(1.35)" }
			}
		},
		"cl-ink-creep": {
			"$description": "Parasite liquid-metal ink creep — cycles cyan → pink → purple → electric-blue with a constant layered bevel and a per-hue neon glow. Moved from the parasite plugin's scoped @keyframes into the SSOT (Universal effects law).",
			"$value": {
				"0%, 100%": {
					"color": "oklch(75% 0.2 191)",
					"text-shadow": "2px 2px 0 oklch(0.1722 0.0382 224.31), -1px -1px 0 oklch(1.0032 0.0305 28.88 / 0.25), 3px 3px 0 oklch(0.1549 0.023 227.75), 4px 4px 0 oklch(0.1357 0.012 230.63), 0 0 12px oklch(0.8262 0.113 201.54 / 0.7), 0 0 24px oklch(0.8262 0.113 201.54 / 0.4), 0 0 48px oklch(0.8262 0.113 201.54 / 0.2)"
				},
				"25%": {
					"color": "oklch(68% 0.24 320)",
					"text-shadow": "2px 2px 0 oklch(0.1722 0.0382 224.31), -1px -1px 0 oklch(1.0032 0.0305 28.88 / 0.25), 3px 3px 0 oklch(0.1549 0.023 227.75), 4px 4px 0 oklch(0.1357 0.012 230.63), 0 0 12px oklch(0.6849 0.1882 350.07 / 0.7), 0 0 24px oklch(0.6849 0.1882 350.07 / 0.4), 0 0 48px oklch(0.6849 0.1882 350.07 / 0.2)"
				},
				"50%": {
					"color": "oklch(72% 0.22 267)",
					"text-shadow": "2px 2px 0 oklch(0.1722 0.0382 224.31), -1px -1px 0 oklch(1.0032 0.0305 28.88 / 0.25), 3px 3px 0 oklch(0.1549 0.023 227.75), 4px 4px 0 oklch(0.1357 0.012 230.63), 0 0 12px oklch(0.5716 0.1741 245.41 / 0.7), 0 0 24px oklch(0.5716 0.1741 245.41 / 0.4), 0 0 48px oklch(0.5716 0.1741 245.41 / 0.2)"
				},
				"75%": {
					"color": "oklch(78% 0.18 220)",
					"text-shadow": "2px 2px 0 oklch(0.1722 0.0382 224.31), -1px -1px 0 oklch(1.0032 0.0305 28.88 / 0.25), 3px 3px 0 oklch(0.1549 0.023 227.75), 4px 4px 0 oklch(0.1357 0.012 230.63), 0 0 12px oklch(0.6062 0.216 218.94 / 0.7), 0 0 24px oklch(0.6062 0.216 218.94 / 0.4), 0 0 48px oklch(0.6062 0.216 218.94 / 0.2)"
				}
			}
		},
		"cl-neon-pulse": {
			"$description": "Parasite neon-pulse overlay — one-shot scale + blur burst. Moved from the parasite plugin's scoped @keyframes into the SSOT.",
			"$value": {
				"0%": { "opacity": "0", "transform": "scale(0.9)", "filter": "blur(8px)" },
				"50%": { "opacity": "0.9", "filter": "blur(4px)" },
				"100%": { "opacity": "0", "transform": "scale(1.1)", "filter": "blur(12px)" }
			}
		}
	}
}
