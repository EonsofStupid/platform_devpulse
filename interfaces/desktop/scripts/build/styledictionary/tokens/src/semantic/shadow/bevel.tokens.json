		"$type": "shadow",
		"$description": "Neumorphic inset shadow treatments — progressive depth via stacked layers.",
		"off": {
			"$value": {
				"color": {
					"colorSpace": "oklch",
					"components": [0, 0, 0],
					"alpha": 0,
					"hex": "#000000"
				},
				"offsetX": { "value": 0, "unit": "rem" },
				"offsetY": { "value": 0, "unit": "rem" },
				"blur": { "value": 0, "unit": "rem" },
				"spread": { "value": 0, "unit": "rem" }
			},
			"$description": "No bevel — flat surface.",
			"$extensions": {
				"com.devpulse.coldlight": { "inset": true, "axis": "bevel", "scope": "primitive" }
			}
		},
