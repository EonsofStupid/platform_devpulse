{
	"$description": "Hand-authored semantic accent aliases — one `{ main, glow, fill }` triplet per brand hue. `main` is the indicator colour; `glow` is the shadow/emission tint; `fill` is the low-alpha area fill used for sparklines and subtle backgrounds. `main` references the generator-emitted primitive ramps; `glow` and `fill` are colour values with tuned alpha.",
	"accent": {
		"$extensions": {
			"com.coldlight": {
				"semanticFamily": "accent",
				"visualFamilies": ["indicator", "glow", "fill"],
				"tokenTier": "semantic"
			}
		},
		"$type": "color",
		"$description": "Semantic accent aliases — main (indicator), glow (shadow/emission), fill (area fill), fg (foreground/on-color text). Intent roles (primary/secondary/tertiary/accent) bind directly to palette seeds; palette entries remain available as Tier-1 primitives.",
		"primary": {
			"$description": "Primary brand role. Default binding: teal. Components consume this for their main brand surface; the visual editor rebinds primary→{palette} without touching components.",
			"main": { "$value": "{accent.teal.main}", "$description": "Primary indicator — bound to teal." },
			"glow": { "$value": "{accent.teal.glow}", "$description": "Primary glow — bound to teal." },
			"fill": { "$value": "{accent.teal.fill}", "$description": "Primary fill — bound to teal." },
			"fg":   { "$value": "{text.primary}",     "$description": "Foreground / on-primary text. Light text on dark brand surface." }
		},
		"secondary": {
			"$description": "Secondary brand role. Default binding: purple. Used for the alternate brand surface paired with primary.",
			"main": { "$value": "{accent.purple.main}", "$description": "Secondary indicator — bound to purple." },
			"glow": { "$value": "{accent.purple.glow}", "$description": "Secondary glow — bound to purple." },
			"fill": { "$value": "{accent.purple.fill}", "$description": "Secondary fill — bound to purple." },
			"fg":   { "$value": "{text.primary}",       "$description": "Foreground / on-secondary text." }
		},
		"tertiary": {
			"$description": "Tertiary brand role. Default binding: azure. Optional third brand surface for richer compositions.",
			"main": { "$value": "{accent.azure.main}", "$description": "Tertiary indicator — bound to azure." },
			"glow": { "$value": "{accent.azure.glow}", "$description": "Tertiary glow — bound to azure." },
			"fill": { "$value": "{accent.azure.fill}", "$description": "Tertiary fill — bound to azure." },
			"fg":   { "$value": "{text.primary}",      "$description": "Foreground / on-tertiary text." }
		},
		"teal": {
			"main": { "$value": "{color.teal.400}", "$description": "Primary indicator colour — teal ramp stop 400." },
			"glow": {
				"$value": { "colorSpace": "oklch", "components": [0.63, 0.08, 173], "alpha": 0.35, "hex": "#519984" },
				"$description": "Drop-shadow / box-shadow emission tint."
			},
			"fill": {
				"$value": { "colorSpace": "oklch", "components": [0.63, 0.08, 173], "alpha": 0.08, "hex": "#519984" },
				"$description": "Sparkline area fill, subtle background tint."
			}
		},
