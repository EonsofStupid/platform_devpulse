			"selection": { "$type": "color", "$value": "oklch(55% 0.18 195 / 0.4)" },
			"selection-purple": { "$type": "color", "$value": "oklch(55% 0.22 280 / 0.4)" },
			"selection-ember": { "$type": "color", "$value": "oklch(60% 0.22 35 / 0.4)" }
