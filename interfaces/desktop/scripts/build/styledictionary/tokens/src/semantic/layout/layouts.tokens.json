			"glow-teal": { "$value": "0 0 0.25rem oklch(70% 0.18 195 / 0.8), 0 0 0.75rem oklch(60% 0.15 195 / 0.5), 0 0 1.5rem oklch(50% 0.12 195 / 0.3)" },
			"glow-purple": { "$value": "0 0 0.25rem oklch(65% 0.2 280 / 0.8), 0 0 0.75rem oklch(55% 0.18 280 / 0.5), 0 0 1.5rem oklch(45% 0.15 280 / 0.3)" },
			"glow-ember": { "$value": "0 0 0.25rem oklch(70% 0.22 35 / 0.8), 0 0 0.75rem oklch(60% 0.2 35 / 0.5), 0 0 1.5rem oklch(50% 0.18 35 / 0.3)" },
			"glow-cyber": { "$value": "0 0 0.25rem oklch(91% 0.16 127 / 0.9), 0 0 0.75rem oklch(85% 0.14 127 / 0.6), 0 0 1.5rem oklch(80% 0.12 127 / 0.3), 0 0 3rem oklch(75% 0.1 127 / 0.15)" },
