{
	"$description": "The owner's shell depth, glass and interaction values, moved from lib/layouts/{app,chat,common}/styles (px to rem, otherwise as written). Values are CSS shorthand strings because several are text-shadows, multi-stop backgrounds or filters, which the DTCG shadow and gradient objects cannot state. Rules that read them live in lib/layouts/{app,chat,common}/styles. Never true black: the darkest values are deep blue, teal and purple.",
	"layouts": {
		"$description": "Shell layout values.",
		"content": {
			"max-width": {
				"$type": "dimension",
				"$value": { "value": 100, "unit": "rem" },
				"$description": "The page column inside the shell, centred on wide windows (the owner's Viewport). 1600 px."
			}
		},
		"depth": {
			"$type": "shadow",
			"$description": "Multi-layer depth, from app/styles/depth.css.",
			"ambient": { "$value": "0 0 5rem -1.25rem oklch(3% 0.02 280 / 0.25)" },
			"key": { "$value": "-0.25rem 0.5rem 1.5rem -0.25rem oklch(2% 0.015 280 / 0.45)" },
			"fill": { "$value": "0.125rem 0.25rem 1rem -0.125rem oklch(5% 0.02 195 / 0.2)" },
			"contact": { "$value": "0 0.125rem 0.25rem -0.0625rem oklch(1% 0.01 200 / 0.6)" },
			"rim": { "$value": "0 -0.0625rem 0.75rem 0.125rem oklch(15% 0.08 195 / 0.15)" },
			"float": { "$value": "{layouts.depth.ambient}, {layouts.depth.contact}" },
			"raised": { "$value": "{layouts.depth.ambient}, {layouts.depth.key}, {layouts.depth.contact}" },
			"elevated": { "$value": "{layouts.depth.ambient}, {layouts.depth.key}, {layouts.depth.fill}, {layouts.depth.contact}" },
			"lifted": { "$value": "{layouts.depth.ambient}, {layouts.depth.key}, {layouts.depth.fill}, {layouts.depth.contact}, {layouts.depth.rim}" }
		},
		"neu": {
			"$type": "shadow",
			"$description": "Neumorphic pairs, from app/styles/depth.css.",
			"light": { "$value": "-0.375rem -0.375rem 1rem oklch(25% 0.04 195 / 0.35)" },
			"shadow": { "$value": "0.375rem 0.375rem 1rem oklch(2% 0.02 280 / 0.5)" },
			"inner-light": { "$value": "inset -0.1875rem -0.1875rem 0.5rem oklch(18% 0.03 195 / 0.25)" },
			"inner-shadow": { "$value": "inset 0.1875rem 0.1875rem 0.5rem oklch(1% 0.015 280 / 0.4)" },
			"thick-light": { "$value": "-0.5rem -0.5rem 1.5rem oklch(22% 0.04 195 / 0.4)" },
			"thick-shadow": { "$value": "0.5rem 0.5rem 1.5rem oklch(1% 0.02 280 / 0.55)" },
			"outset": { "$value": "{layouts.neu.light}, {layouts.neu.shadow}" },
			"inset": { "$value": "{layouts.neu.inner-light}, {layouts.neu.inner-shadow}" },
			"thick": { "$value": "{layouts.neu.thick-light}, {layouts.neu.thick-shadow}" }
		},
		"rim": {
			"$type": "shadow",
			"$description": "Rim lights, from app/styles/depth.css.",
			"subtle": { "$value": "0 0 0.5rem 0.0625rem oklch(65% 0.12 195 / 0.3)" },
			"medium": { "$value": "0 0 0.75rem 0.125rem oklch(70% 0.15 195 / 0.45)" },
			"strong": { "$value": "0 0 1rem 0.125rem oklch(75% 0.18 195 / 0.6)" }
		},
		"edge": {
