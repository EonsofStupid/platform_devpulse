			"shadow": { "$type": "shadow", "$value": "inset 0.125rem 0.125rem 0.25rem oklch(0.8 0.06 195 / 0.15), inset -0.125rem -0.125rem 0.25rem oklch(0.05 0.02 280 / 0.4), 0 0 2.5rem oklch(0.55 0.15 195 / 0.1), 0 0.5rem 2rem oklch(0.02 0.01 280 / 0.5)" }
		},
