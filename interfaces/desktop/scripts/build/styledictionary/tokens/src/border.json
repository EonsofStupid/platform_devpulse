{
	"borderWidth": {
		"$type": "dimension",
		"$description": "Border width scale (px → rem via SD5 transform)",
		"thin": {
			"$value": "1px",
			"$description": "Default border, dividers, grid lines"
		},
		"medium": {
			"$value": "2px",
			"$description": "Focus rings, emphasis borders"
		},
		"thick": {
			"$value": "3px",
			"$description": "Active state, strong emphasis"
		}
	},
	"outlineOffset": {
		"$type": "dimension",
		"$description": "Outline offset scale (px → rem via SD5 transform)",
		"sm": {
			"$value": "1px"
		},
		"md": {
			"$value": "2px"
		},
		"lg": {
			"$value": "4px"
		}
	},
	"border": {
		"$type": "color",
		"$description": "Named border color presets",
		"subtle": {
			"$value": "oklch(0.4256 0.0453 163.89 / 0.22)",
			"$description": "Default container border",
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-700) l c h / 0.22)"
				}
			}
		},
		"strong": {
			"$value": "oklch(0.5133 0.0547 163.65 / 0.302)",
			"$description": "Emphasized container border",
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-teal-600) l c h / 0.30)"
				}
			}
		},
		"focus": {
			"$value": "{color.teal.400}",
			"$description": "Focus ring color"
		},
		"divider": {
			"$value": "oklch(1.0032 0.0305 28.88 / 0.059)",
			"$description": "Section separator"
		},
		"soft": {
			"$value": "oklch(0.5133 0.0547 163.65 / 0.30)",
			"$description": "Soft container border — alias for strong at same opacity"
		},
		"emphasis": {
			"$value": "{border.strong}",
			"$description": "Emphasized border — alias for strong"
		}
	},
	"borderRise": {
		"$type": "border",
		"$description": "Luminance-based border rise — light edge on dark surface, creates raised appearance",
		"subtle": {
			"$value": {
				"color": "oklch(1.0032 0.0305 28.88 / 0.059)",
				"width": "1px",
				"style": "solid"
			},
			"$description": "Barely visible luminance edge — inputs, secondary containers"
		},
		"soft": {
			"$value": {
				"color": "oklch(1.0032 0.0305 28.88 / 0.102)",
				"width": "1px",
				"style": "solid"
			},
			"$description": "Visible luminance edge — cards, primary containers"
		},
		"strong": {
			"$value": {
				"color": "oklch(1.0032 0.0305 28.88 / 0.161)",
				"width": "1px",
				"style": "solid"
			},
			"$description": "Prominent luminance edge — elevated containers, dialogs"
		}
	},
	"borderPreset": {
		"$type": "border",
		"$description": "Named border presets — complete color + width + style",
		"default": {
			"$value": {
				"color": "{border.subtle}",
				"width": "1px",
				"style": "solid"
			},
			"$description": "Standard container border"
		},
		"strong": {
			"$value": {
				"color": "{border.strong}",
				"width": "1px",
				"style": "solid"
			},
			"$description": "Emphasized container border"
		},
		"focus": {
			"$value": {
				"color": "{border.focus}",
				"width": "2px",
				"style": "solid"
			},
			"$description": "Focus ring"
		},
		"divider": {
			"$value": {
				"color": "{border.divider}",
				"width": "1px",
				"style": "solid"
			},
			"$description": "Section separator"
		}
