{
	"borderWidth": {
		"$type": "dimension",
		"$description": "Border width scale (px → rem via SD5 transform)",
		"thin":   { "$value": "1px", "$description": "Default border, dividers, grid lines" },
		"medium": { "$value": "2px", "$description": "Focus rings, emphasis borders" },
		"thick":  { "$value": "3px", "$description": "Active state, strong emphasis" }
	},
	"outlineOffset": {
		"$type": "dimension",
		"$description": "Outline offset scale (px → rem via SD5 transform)",
		"sm": { "$value": "1px" },
		"md": { "$value": "2px" },
		"lg": { "$value": "4px" }
	},
	"border": {
		"$type": "color",
		"$description": "Named border color presets",
		"subtle": {
			"$value": "#005c4a38",
			"$description": "Default container border",
			"$extensions": { "com.coldlight": { "cssRuntime": true, "cssExpression": "oklch(from var(--color-mint-700) l c h / 0.22)" } }
		},
		"strong": {
			"$value": "#0078614d",
			"$description": "Emphasized container border",
			"$extensions": { "com.coldlight": { "cssRuntime": true, "cssExpression": "oklch(from var(--color-mint-600) l c h / 0.30)" } }
		},
		"focus": {
			"$value": "{color.mint.400}",
			"$description": "Focus ring color"
		},
		"divider": {
			"$value": "#ffffff0f",
			"$description": "Section separator"
		}
	},
	"borderPreset": {
		"$type": "border",
		"$description": "Named border presets — complete color + width + style",
		"default": {
			"$value": { "color": "{border.subtle}", "width": "1px", "style": "solid" },
			"$description": "Standard container border"
		},
		"strong": {
			"$value": { "color": "{border.strong}", "width": "1px", "style": "solid" },
			"$description": "Emphasized container border"
		},
		"focus": {
			"$value": { "color": "{border.focus}", "width": "2px", "style": "solid" },
			"$description": "Focus ring"
		},
		"divider": {
			"$value": { "color": "{border.divider}", "width": "1px", "style": "solid" },
			"$description": "Section separator"
		}
	}
}
