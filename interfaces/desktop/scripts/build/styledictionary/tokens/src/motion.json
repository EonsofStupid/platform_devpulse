{
	"motion": {
		"$description": "Motion tokens — durations, easings, animations",
		"duration": {
			"$type": "duration",
			"$description": "Duration scale",
			"snap":     { "$value": "50ms" },
			"fast":     { "$value": "150ms" },
			"normal":   { "$value": "250ms" },
			"smooth":   { "$value": "400ms" },
			"glacial":  { "$value": "700ms" },
			"moderate": { "$value": "3000ms" }
		},
		"ease": {
			"$type": "cubicBezier",
			"$description": "Easing / timing functions",
			"linear": { "$value": [0, 0, 1, 1] },
			"in":     { "$value": [0.4, 0, 1, 1] },
			"out":    { "$value": [0, 0, 0.2, 1] },
			"inOut":  { "$value": [0.4, 0, 0.2, 1] },
			"spring": { "$value": [0.34, 1.56, 0.64, 1] },
			"bounce": { "$value": [0.68, -0.55, 0.27, 1.55] }
		},
		"animation": {
			"$description": "Named animation shorthands — reference @keyframes",
			"pulse-glow": {
				"$value": "pulse-glow 4s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "pulse-glow", "iterationCount": "infinite" } }
			},
			"breathe": {
				"$value": "breathe 4s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "breathe", "iterationCount": "infinite" } }
			},
			"shimmer": {
				"$value": "shimmer 8s linear infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "shimmer", "iterationCount": "infinite" } }
			},
			"drift": {
				"$value": "drift 8s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "drift", "iterationCount": "infinite" } }
			},
			"pulse": {
				"$value": "pulse 3s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "pulse", "iterationCount": "infinite" } }
			},
			"fade-in": {
				"$value": "fade-in 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "fade-in", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"slide-up": {
				"$value": "slide-up 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "slide-up", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"slide-down": {
				"$value": "slide-down 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "slide-down", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"scale-in": {
				"$value": "scale-in 250ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "scale-in", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"grow": {
				"$value": "cl-grow 300ms ease-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "cl-grow", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"shrink": {
				"$value": "cl-shrink 200ms ease-in forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "cl-shrink", "iterationCount": 1, "fillMode": "forwards" } }
			},
			"shake": {
				"$value": "cl-shake 400ms ease-in-out",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "cl-shake", "iterationCount": 1 } }
			},
			"spin": {
				"$value": "cl-spin 1s linear infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "cl-spin", "iterationCount": "infinite" } }
			},
			"float": {
				"$value": "cl-float 6s ease-in-out infinite",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "cl-float", "iterationCount": "infinite" } }
			},
			"flip": {
				"$value": "cl-flip 600ms ease-in-out forwards",
				"$extensions": { "com.coldlight": { "type": "animation", "keyframe": "cl-flip", "iterationCount": 1, "fillMode": "forwards" } }
			}
		}
	},
	"transition": {
		"$description": "Named transition presets — complete property + duration + easing combos",
		"fade": {
			"$value": "opacity 150ms cubic-bezier(0, 0, 0.2, 1)",
			"$description": "Opacity fade for show/hide"
		},
		"color": {
			"$value": "color, background-color, border-color 150ms cubic-bezier(0, 0, 0.2, 1)",
			"$description": "Color property transitions for hover/focus"
		},
		"expand": {
			"$value": "height, padding 250ms cubic-bezier(0.4, 0, 0.2, 1)",
			"$description": "Expand/collapse for accordions, panels"
		},
		"slide": {
			"$value": "transform 200ms cubic-bezier(0, 0, 0.2, 1)",
			"$description": "Slide translation for menus, drawers"
		},
		"scale": {
			"$value": "transform 150ms cubic-bezier(0, 0, 0.2, 1)",
			"$description": "Scale pop for tooltips, popovers"
		},
		"shadow": {
			"$value": "box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1)",
			"$description": "Shadow elevation change"
		},
		"all-fast": {
			"$value": "all 150ms cubic-bezier(0, 0, 0.2, 1)",
			"$description": "Catch-all fast transition"
		},
		"all-normal": {
			"$value": "all 250ms cubic-bezier(0.4, 0, 0.2, 1)",
			"$description": "Catch-all normal transition"
		},
		"spring": {
			"$value": "transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1)",
			"$description": "Bouncy spring for playful interactions"
		},
		"none": {
			"$value": "none",
			"$description": "Disable transitions (reduced motion)"
		}
	}
}
