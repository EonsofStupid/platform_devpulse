{
	"preset": {
		"heading": {
			"default": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.subtle}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Neuro-elevated — teal glow text shadow, minimal depth for typography",
				"$extensions": {
					"com.coldlight": {
						"kind": "heading",
						"intent": "default",
						"encoding": "v-s3z0d1b1g1f0m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 1,
							"bevel": 1,
							"glow": 1,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z1), var(--bevel-subtle), var(--glow-teal)",
							"border": "none",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"glass": {
				"$value": {
					"surface": "{surface.raised}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Glass deep — translucent heading, no depth",
				"$extensions": {
					"com.coldlight": {
						"kind": "heading",
						"intent": "glass",
						"encoding": "v-s2z0d0b0g0f0m0t1",
						"axis": {
							"surface": 2,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-smoke)",
							"backdropFilter": "blur(8px)",
							"boxShadow": "none",
							"border": "none",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"flat": {
				"$value": {
					"surface": "{glass.void}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Flat minimal — plain text, no visual treatment",
				"$extensions": {
					"com.coldlight": {
						"kind": "heading",
						"intent": "flat",
						"encoding": "v-s0z0d0b0g0f0m0t1",
						"axis": {
							"surface": 0,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "transparent",
							"boxShadow": "none",
							"border": "none",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"matte": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Matte solid — opaque background heading, no depth",
				"$extensions": {
					"com.coldlight": {
						"kind": "heading",
						"intent": "matte",
						"encoding": "v-s1z0d0b0g0f0m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--surface-base)",
							"boxShadow": "none",
							"border": "none",
							"transition": "var(--transition-color)"
						}
					}
				}
			}
		}
	}
}
