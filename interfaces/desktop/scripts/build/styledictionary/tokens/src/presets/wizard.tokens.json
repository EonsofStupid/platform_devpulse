{
	"$extensions": {
		"com.coldlight": {
			"semanticFamilies": ["surface", "elevation", "frame", "motion"],
			"format": "coldlight-style-presets-v1",
			"note": "Wizard brand family — onboarding tiers COMPOSED from the designed token library (glass surfaces, gradient-surface fields, depth stacks, glow shadows, accent triplets, radius/blur/duration scales). var() references resolve at runtime against the emitted tokens; no invented literals. wizard-deep = Tier-2 shell, wizard-solid = Tier-3 panel, wizard-elevated = Tier-4 wells."
		}
	},
	"preset": {
		"wizard-deep": {
			"$description": "wizard-deep: Tier-2 onboarding shell — blue glass identity (Lock #6), SEED lightness raised from the L0.11 glass primitive so the shell separates from the L~0.08 void backdrop (2026-07-12 black-wizard fix; hue 240 unchanged)",
			"background-color": {
				"$value": "oklch(0.16 0.05 240 / 0.94)",
				"$type": "string"
			},
			"gradient": {
				"$value": "linear-gradient(180deg, oklch(0.19 0.055 240) 0%, oklch(0.12 0.05 240) 100%)",
				"$type": "string"
			},
			"border-radius": {
				"$value": "var(--radius-lg)",
				"$type": "string"
			},
			"box-shadow": {
				"$value": "var(--depth-z3)",
				"$type": "string"
			},
			"color": {
				"$value": "var(--text-primary)",
				"$type": "string"
			},
			"border-color": {
				"$value": "color-mix(in oklch, var(--accent-blue-main) 45%, transparent)",
				"$type": "string"
			},
			"border-width": {
				"$value": "var(--border-width-hairline)",
				"$type": "string"
			},
			"backdrop-filter": {
				"$value": "blur(var(--blur-lg))",
				"$type": "string"
			},
			"transition-duration": {
				"$value": "var(--duration-normal)",
				"$type": "string"
			},
			"transition-timing-function": {
				"$value": "cubic-bezier(0.4, 0, 0.2, 1)",
				"$type": "cubicBezier"
			}
		},
		"wizard-solid": {
			"$description": "wizard-solid: Tier-3 onboarding content panel — purple glass identity, SEED lightness raised one rung above wizard-deep (2026-07-12 black-wizard fix; hue 300 family unchanged)",
			"background-color": {
				"$value": "oklch(0.2 0.045 300 / 0.96)",
				"$type": "string"
			},
			"gradient": {
				"$value": "linear-gradient(180deg, oklch(0.22 0.05 300) 0%, oklch(0.15 0.045 300) 100%)",
				"$type": "string"
			},
			"border-radius": {
				"$value": "var(--radius-md)",
				"$type": "string"
			},
			"box-shadow": {
				"$value": "var(--depth-z2), var(--bevel-subtle)",
				"$type": "string"
			},
			"color": {
				"$value": "var(--text-primary)",
				"$type": "string"
			},
			"border-color": {
				"$value": "color-mix(in oklch, var(--accent-purple-main) 40%, transparent)",
				"$type": "string"
			},
			"border-width": {
				"$value": "var(--border-width-hairline)",
				"$type": "string"
			},
			"transition-duration": {
				"$value": "var(--duration-normal)",
				"$type": "string"
			},
			"transition-timing-function": {
				"$value": "cubic-bezier(0.4, 0, 0.2, 1)",
				"$type": "cubicBezier"
			}
		},
		"wizard-elevated": {
			"$description": "wizard-elevated: Tier-4 onboarding wells (mode cards, address panel) — teal glass identity, SEED lightness at the top of the wizard ladder (2026-07-12 black-wizard fix; hue 195 unchanged). Ladder: void ~0.08 → deep 0.16 → solid 0.20 → elevated 0.24",
			"background-color": {
				"$value": "oklch(0.24 0.04 195 / 0.94)",
				"$type": "string"
			},
			"gradient": {
				"$value": "linear-gradient(180deg, oklch(0.26 0.045 195) 0%, oklch(0.19 0.04 195) 100%)",
				"$type": "string"
			},
			"border-radius": {
				"$value": "var(--radius-md)",
				"$type": "string"
			},
			"box-shadow": {
				"$value": "var(--depth-z1)",
				"$type": "string"
			},
			"color": {
				"$value": "var(--text-primary)",
				"$type": "string"
			},
			"border-color": {
				"$value": "color-mix(in oklch, var(--accent-cyan-main) 40%, transparent)",
				"$type": "string"
			},
			"border-width": {
				"$value": "var(--border-width-hairline)",
				"$type": "string"
			},
			"backdrop-filter": {
				"$value": "blur(var(--blur-sm))",
				"$type": "string"
			},
			"transition-duration": {
				"$value": "var(--duration-fast)",
				"$type": "string"
			},
			"transition-timing-function": {
				"$value": "cubic-bezier(0.4, 0, 0.2, 1)",
				"$type": "cubicBezier"
			}
		}
	}
}
