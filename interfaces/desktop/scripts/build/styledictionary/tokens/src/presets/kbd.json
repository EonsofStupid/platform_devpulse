{
	"preset": {
		"kbd": {
			"default": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.deep}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Neuro-elevated — teal glow, inset bevel key-cap, glass surface",
				"$extensions": {
					"com.coldlight": {
						"kind": "kbd",
						"intent": "default",
						"encoding": "v-s3z0d1b4g1f1m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 1,
							"bevel": 4,
							"glow": 1,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z1), var(--bevel-inset), var(--glow-teal)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"glass": {
				"$value": {
					"surface": "{surface.raised}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.deep}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Glass deep — translucent key-cap with inset bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "kbd",
						"intent": "glass",
						"encoding": "v-s2z0d1b4g0f1m0t1",
						"axis": {
							"surface": 2,
							"material": 0,
							"depth": 1,
							"bevel": 4,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-smoke)",
							"backdropFilter": "blur(8px)",
							"boxShadow": "var(--shadow-z1), var(--bevel-inset)",
							"border": "1px solid var(--border-subtle)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"flat": {
				"$value": {
					"surface": "{glass.void}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Flat minimal — simple bordered key badge, no depth",
				"$extensions": {
					"com.coldlight": {
						"kind": "kbd",
						"intent": "flat",
						"encoding": "v-s0z0d0b0g0f0m0t1",
						"axis": {
							"surface": 0,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "transparent",
							"boxShadow": "none",
							"border": "1px solid transparent",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"matte": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.deep}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Matte solid — opaque key-cap with inset bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "kbd",
						"intent": "matte",
						"encoding": "v-s1z0d1b4g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 1,
							"bevel": 4,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--surface-base)",
							"boxShadow": "var(--shadow-z1), var(--bevel-inset)",
							"border": "1px solid var(--border-subtle)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"stark": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.subtle}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Stark — crisp 2D neumorphism. Linear-gradient surface, single shadow, zero blur. Fast cold load.",
				"$extensions": {
					"com.coldlight": {
						"kind": "kbd",
						"intent": "stark",
						"encoding": "v-s1z0d1b0g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 1,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "linear-gradient(180deg, oklch(0.14 0.01 224), oklch(0.1 0.008 224))",
							"border-color": "oklch(0.3 0.02 224 / 0.25)",
							"border-width": "0.0625rem",
							"border-style": "solid",
							"border-radius": "var(--radius-md)",
							"box-shadow": "0 0.0625rem 0.1875rem oklch(0 0 0 / 0.2)",
							"color": "oklch(0.93 0.015 224)",
							"transition-duration": "var(--motion-duration-fast)",
							"transition-timing-function": "var(--motion-ease-out)"
						}
					}
				}
			}
		}
	}
}
