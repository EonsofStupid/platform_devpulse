			"semanticFamilies": [
				"surface",
				"elevation",
				"frame",
				"motion"
			],
			"format": "coldlight-style-presets-v1",
			"note": "Composite preset leaves — elevation uses DTCG shadow; surface uses color/dimension; keep render glue out of token values."
		}
	},
