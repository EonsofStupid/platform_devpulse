{
	"preset": {
		"$description": "Loading overlay preset compositions — glass overlay surfaces for loading states. VPB creates new presets by writing to this file.",
		"loading-overlay": {
			"default": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z3}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Neuro-elevated — teal glow glass overlay, heavy blur",
				"$extensions": {
					"com.coldlight": {
						"kind": "loading-overlay",
						"intent": "default",
						"encoding": "v-s3z0d3b2g1f0m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 3,
							"bevel": 2,
							"glow": 1,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(16px)",
							"boxShadow": "var(--shadow-z3), var(--bevel-soft), var(--glow-teal)",
							"border": "none",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"glass": {
				"$value": {
					"surface": "{glass.deep}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.subtle}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Glass deep — deep glass overlay with heavy blur",
				"$extensions": {
					"com.coldlight": {
						"kind": "loading-overlay",
						"intent": "glass",
						"encoding": "v-s4z0d2b1g0f0m0t1",
						"axis": {
							"surface": 4,
							"material": 0,
							"depth": 2,
							"bevel": 1,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(20px)",
							"boxShadow": "var(--shadow-z2), var(--bevel-subtle)",
							"border": "none",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"flat": {
				"$value": {
					"surface": "{glass.void}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Flat minimal — semi-transparent overlay, no effects",
				"$extensions": {
					"com.coldlight": {
						"kind": "loading-overlay",
						"intent": "flat",
						"encoding": "v-s0z0d0b0g0f0m0t1",
						"axis": {
							"surface": 0,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "transparent",
							"boxShadow": "none",
							"border": "none",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"matte": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Matte solid — opaque overlay scrim",
				"$extensions": {
					"com.coldlight": {
						"kind": "loading-overlay",
						"intent": "matte",
						"encoding": "v-s1z0d1b0g0f0m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 1,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--surface-base)",
							"boxShadow": "var(--shadow-z1)",
							"border": "none",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			}
		}
	}
}
