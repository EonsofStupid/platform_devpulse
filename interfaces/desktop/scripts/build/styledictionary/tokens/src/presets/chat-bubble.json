{
	"preset": {
		"chat-bubble": {
			"ai": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.subtle}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "AI message bubble — glass deep, teal left border glow, subtle bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "chat-bubble",
						"intent": "ai",
						"encoding": "v-s3z0d1b1g1f1m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 1,
							"bevel": 1,
							"glow": 1,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(8px)",
							"boxShadow": "var(--shadow-z1), var(--bevel-subtle), inset 3px 0 8px var(--accent-teal-glow)",
							"borderLeft": "2px solid var(--accent-teal-main)",
							"borderRadius": "var(--radius-lg)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"user": {
				"$value": {
					"surface": "{surface.raised}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.all-fast}"
				},
				"$description": "User message bubble — subtle glass, no glow, minimal",
				"$extensions": {
					"com.coldlight": {
						"kind": "chat-bubble",
						"intent": "user",
						"encoding": "v-s2z0d0b0g0f1m0t1",
						"axis": {
							"surface": 2,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-smoke)",
							"border": "1px solid var(--border-subtle)",
							"borderRadius": "var(--radius-lg)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"system": {
				"$value": {
					"surface": "{glass.void}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "System message — transparent, divider border, minimal",
				"$extensions": {
					"com.coldlight": {
						"kind": "chat-bubble",
						"intent": "system",
						"encoding": "v-s0z0d0b0g0f0m0t1",
						"axis": {
							"surface": 0,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "transparent",
							"border": "1px solid var(--border-divider)",
							"borderRadius": "var(--radius-md)",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"stark": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.subtle}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Stark — crisp 2D neumorphism. Linear-gradient surface, single shadow, zero blur. Fast cold load.",
				"$extensions": {
					"com.coldlight": {
						"kind": "chat-bubble",
						"intent": "stark",
						"encoding": "v-s1z0d1b0g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 1,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "linear-gradient(180deg, oklch(0.14 0.01 224), oklch(0.1 0.008 224))",
							"border-color": "oklch(0.3 0.02 224 / 0.25)",
							"border-width": "0.0625rem",
							"border-style": "solid",
							"border-radius": "var(--radius-md)",
							"box-shadow": "0 0.0625rem 0.1875rem oklch(0 0 0 / 0.2)",
							"color": "oklch(0.93 0.015 224)",
							"transition-duration": "var(--motion-duration-fast)",
							"transition-timing-function": "var(--motion-ease-out)"
						}
					}
				}
			}
		}
	}
}
