{
	"preset": {
		"calendar": {
			"default": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Neuro-elevated — glass grid surface, teal selection glow, soft bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "calendar",
						"intent": "default",
						"encoding": "v-s3z0d2b2g1f1m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 2,
							"bevel": 2,
							"glow": 1,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z2), var(--bevel-soft), var(--glow-teal)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"glass": {
				"$value": {
					"surface": "{glass.deep}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.subtle}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Glass-deep — deep glass grid, teal glow on hover/select, subtle frame",
				"$extensions": {
					"com.coldlight": {
						"kind": "calendar",
						"intent": "glass",
						"encoding": "v-s4z0d1b1g1f0m0t1",
						"axis": {
							"surface": 4,
							"material": 0,
							"depth": 1,
							"bevel": 1,
							"glow": 1,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(16px)",
							"boxShadow": "var(--shadow-z1), var(--bevel-subtle), var(--glow-teal)",
							"border": "1px solid var(--border-subtle)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"flat": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.color}"
				},
				"$description": "Flat-minimal — solid surface grid, no depth, no glow",
				"$extensions": {
					"com.coldlight": {
						"kind": "calendar",
						"intent": "flat",
						"encoding": "v-s1z0d0b0g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--surface-base)",
							"boxShadow": "none",
							"border": "1px solid var(--border-default)",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"matte": {
				"$value": {
					"surface": "{surface.raised}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.medium}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-normal}"
				},
				"$description": "Matte-solid — raised grid surface, medium bevel, no glow",
				"$extensions": {
					"com.coldlight": {
						"kind": "calendar",
						"intent": "matte",
						"encoding": "v-s2z0d1b3g0f1m0t2",
						"axis": {
							"surface": 2,
							"material": 0,
							"depth": 1,
							"bevel": 3,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 2
						},
						"css": {
							"background": "var(--surface-raised)",
							"boxShadow": "var(--shadow-z1), var(--bevel-medium)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-normal)"
						}
					}
				}
			}
		}
	}
}
