{
	"preset": {
		"button": {
			"primary": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Primary action — teal glow, glass surface, soft bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "button",
						"intent": "primary",
						"encoding": "v-s3z0d2b2g1f1m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 2,
							"bevel": 2,
							"glow": 1,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z2), var(--bevel-soft), var(--glow-teal)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"secondary": {
				"$value": {
					"surface": "{surface.raised}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.subtle}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Secondary action — subtle glass, no glow, light bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "button",
						"intent": "secondary",
						"encoding": "v-s2z0d1b1g0f1m0t1",
						"axis": {
							"surface": 2,
							"material": 0,
							"depth": 1,
							"bevel": 1,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-smoke)",
							"backdropFilter": "blur(8px)",
							"boxShadow": "var(--shadow-z1), var(--bevel-subtle)",
							"border": "1px solid var(--border-subtle)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"ghost": {
				"$value": {
					"surface": "{glass.void}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.divider}",
					"transition": "{transition.color}"
				},
				"$description": "Ghost — transparent, no depth, border on hover only",
				"$extensions": {
					"com.coldlight": {
						"kind": "button",
						"intent": "ghost",
						"encoding": "v-s0z0d0b0g0f0m0t1",
						"axis": {
							"surface": 0,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "transparent",
							"boxShadow": "none",
							"border": "1px solid transparent",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"danger": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.ember}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Danger action — ember glow, glass surface, soft bevel",
				"$extensions": {
					"com.coldlight": {
						"kind": "button",
						"intent": "danger",
						"encoding": "v-s3z0d2b2g4f1m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 2,
							"bevel": 2,
							"glow": 4,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z2), var(--bevel-soft), var(--glow-ember)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"voice-active": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z3}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.ember}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Voice active — ember/red glow, pulsing, circular",
				"$extensions": {
					"com.coldlight": {
						"kind": "button",
						"intent": "voice-active",
						"encoding": "v-s3z0d3b2g4f1m1t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 3,
							"bevel": 2,
							"glow": 4,
							"frame": 1,
							"motion": 1,
							"transition": 1
						},
						"css": {
							"background": "var(--accent-ember-fill)",
							"borderRadius": "var(--radius-full)",
							"boxShadow": "0 0 16px var(--accent-ember-glow), var(--shadow-z3), var(--bevel-soft)",
							"border": "1px solid var(--accent-ember-main)",
							"animation": "var(--motion-animation-pulse-glow)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"stark": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.subtle}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Stark — crisp 2D neumorphism. Linear-gradient surface, single shadow, zero blur. Fast cold load.",
				"$extensions": {
					"com.coldlight": {
						"kind": "button",
						"intent": "stark",
						"encoding": "v-s1z0d1b0g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 1,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "linear-gradient(180deg, oklch(0.14 0.01 224), oklch(0.1 0.008 224))",
							"border-color": "oklch(0.3 0.02 224 / 0.25)",
							"border-width": "0.0625rem",
							"border-style": "solid",
							"border-radius": "var(--radius-md)",
							"box-shadow": "0 0.0625rem 0.1875rem oklch(0 0 0 / 0.2)",
							"color": "oklch(0.93 0.015 224)",
							"transition-duration": "var(--motion-duration-fast)",
							"transition-timing-function": "var(--motion-ease-out)"
						}
					}
				}
			}
		}
	}
}
