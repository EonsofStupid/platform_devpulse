{
	"preset": {
		"card": {
			"default": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Neuro-elevated — glass-deep surface, medium depth, soft bevel, teal glow",
				"$extensions": {
					"com.coldlight": {
						"kind": "card",
						"intent": "default",
						"encoding": "v-s3z0d2b2g1f1m0t1",
						"axis": {
							"surface": 3,
							"material": 0,
							"depth": 2,
							"bevel": 2,
							"glow": 1,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z2), var(--bevel-soft), var(--glow-teal)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"glass": {
				"$value": {
					"surface": "{glass.deep}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Glass-deep — deep glass container, medium depth, teal glow edges",
				"$extensions": {
					"com.coldlight": {
						"kind": "card",
						"intent": "glass",
						"encoding": "v-s4z0d2b2g1f0m0t1",
						"axis": {
							"surface": 4,
							"material": 0,
							"depth": 2,
							"bevel": 2,
							"glow": 1,
							"frame": 0,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(16px)",
							"boxShadow": "var(--shadow-z2), var(--bevel-soft), var(--glow-teal)",
							"border": "1px solid var(--border-subtle)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"flat": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z0}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.default}",
					"transition": "{transition.color}"
				},
				"$description": "Flat-minimal — solid surface, no depth, no glow, simple border",
				"$extensions": {
					"com.coldlight": {
						"kind": "card",
						"intent": "flat",
						"encoding": "v-s1z0d0b0g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 0,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "var(--surface-base)",
							"boxShadow": "none",
							"border": "1px solid var(--border-default)",
							"transition": "var(--transition-color)"
						}
					}
				}
			},
			"matte": {
				"$value": {
					"surface": "{surface.raised}",
					"depth": "{shadow.z2}",
					"bevel": "{bevel.pronounced}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-normal}"
				},
				"$description": "Matte-solid — raised surface, strong bevel, medium depth, no glow",
				"$extensions": {
					"com.coldlight": {
						"kind": "card",
						"intent": "matte",
						"encoding": "v-s2z0d2b4g0f1m0t2",
						"axis": {
							"surface": 2,
							"material": 0,
							"depth": 2,
							"bevel": 4,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 2
						},
						"css": {
							"background": "var(--surface-raised)",
							"boxShadow": "var(--shadow-z2), var(--bevel-strong)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-normal)"
						}
					}
				}
			},
			"stark": {
				"$value": {
					"surface": "{surface.base}",
					"depth": "{shadow.z1}",
					"bevel": "{bevel.off}",
					"glow": "{glow.off}",
					"frame": "{borderPreset.subtle}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Stark — crisp 2D neumorphism. Linear-gradient surface, single shadow, zero blur. Fast cold load.",
				"$extensions": {
					"com.coldlight": {
						"kind": "card",
						"intent": "stark",
						"encoding": "v-s1z0d1b0g0f1m0t1",
						"axis": {
							"surface": 1,
							"material": 0,
							"depth": 1,
							"bevel": 0,
							"glow": 0,
							"frame": 1,
							"motion": 0,
							"transition": 1
						},
						"css": {
							"background": "linear-gradient(180deg, oklch(0.14 0.01 224), oklch(0.1 0.008 224))",
							"border-color": "oklch(0.3 0.02 224 / 0.25)",
							"border-width": "0.0625rem",
							"border-style": "solid",
							"border-radius": "var(--radius-md)",
							"box-shadow": "0 0.0625rem 0.1875rem oklch(0 0 0 / 0.2)",
							"color": "oklch(0.93 0.015 224)",
							"transition-duration": "var(--motion-duration-fast)",
							"transition-timing-function": "var(--motion-ease-out)"
						}
					}
				}
			}
		}
	}
}
