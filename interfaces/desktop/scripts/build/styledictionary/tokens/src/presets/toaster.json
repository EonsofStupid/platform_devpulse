{
	"preset": {
		"toaster": {
			"default": {
				"$value": {
					"surface": "{surface.overlay}",
					"depth": "{shadow.z3}",
					"bevel": "{bevel.soft}",
					"glow": "{glow.teal}",
					"frame": "{borderPreset.strong}",
					"transition": "{transition.all-fast}"
				},
				"$description": "Toast notification — glass overlay, teal glow accent, strong depth for attention",
				"$extensions": {
					"com.coldlight": {
						"kind": "toaster",
						"intent": "default",
						"encoding": "v-s3z0d3b2g1f1m0t1",
						"axis": { "surface": 3, "material": 0, "depth": 3, "bevel": 2, "glow": 1, "frame": 1, "motion": 0, "transition": 1 },
						"css": {
							"background": "var(--glass-deep)",
							"backdropFilter": "blur(12px)",
							"boxShadow": "var(--shadow-z3), var(--bevel-soft), var(--glow-teal)",
							"border": "1px solid var(--border-strong)",
							"transition": "var(--transition-all-fast)"
						}
					}
				}
			},
			"glass": {
				"$value": { "surface": "{surface.raised}", "depth": "{shadow.z2}", "bevel": "{bevel.subtle}", "glow": "{glow.off}", "frame": "{borderPreset.default}", "transition": "{transition.all-fast}" },
				"$description": "Glass deep toast",
				"$extensions": { "com.coldlight": { "kind": "toaster", "intent": "glass", "encoding": "v-s2z0d2b1g0f1m0t1", "axis": { "surface": 2, "material": 0, "depth": 2, "bevel": 1, "glow": 0, "frame": 1, "motion": 0, "transition": 1 }, "css": { "background": "var(--glass-smoke)", "backdropFilter": "blur(8px)", "boxShadow": "var(--shadow-z2), var(--bevel-subtle)", "border": "1px solid var(--border-subtle)", "transition": "var(--transition-all-fast)" } } }
			},
			"flat": {
				"$value": { "surface": "{glass.void}", "depth": "{shadow.z0}", "bevel": "{bevel.off}", "glow": "{glow.off}", "frame": "{borderPreset.divider}", "transition": "{transition.color}" },
				"$description": "Flat minimal toast",
				"$extensions": { "com.coldlight": { "kind": "toaster", "intent": "flat", "encoding": "v-s0z0d0b0g0f0m0t1", "axis": { "surface": 0, "material": 0, "depth": 0, "bevel": 0, "glow": 0, "frame": 0, "motion": 0, "transition": 1 }, "css": { "background": "transparent", "boxShadow": "none", "border": "1px solid transparent", "transition": "var(--transition-color)" } } }
			},
			"matte": {
				"$value": { "surface": "{surface.base}", "depth": "{shadow.z1}", "bevel": "{bevel.off}", "glow": "{glow.off}", "frame": "{borderPreset.default}", "transition": "{transition.all-fast}" },
				"$description": "Matte solid toast",
				"$extensions": { "com.coldlight": { "kind": "toaster", "intent": "matte", "encoding": "v-s1z0d1b0g0f1m0t1", "axis": { "surface": 1, "material": 0, "depth": 1, "bevel": 0, "glow": 0, "frame": 1, "motion": 0, "transition": 1 }, "css": { "background": "var(--surface-base)", "boxShadow": "var(--shadow-z1)", "border": "1px solid var(--border-subtle)", "transition": "var(--transition-all-fast)" } } }
			}
		}
	}
}
