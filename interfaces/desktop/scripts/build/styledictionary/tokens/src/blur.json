{
	"blur": {
		"$type": "dimension",
		"$description": "Backdrop blur scale — used by glass surfaces and material treatments",
		"$extensions": {
			"com.coldlight": {
				"control": "slider",
				"scale": { "min": 0, "max": 24, "step": 4, "unit": "px" },
				"default": "md",
				"tier": "primitive"
			}
		},
		"off": { "$value": "0px" },
		"sm":  { "$value": "4px" },
		"md":  { "$value": "8px" },
		"lg":  { "$value": "12px" },
		"xl":  { "$value": "16px" },
		"2xl": { "$value": "24px" }
	}
}
