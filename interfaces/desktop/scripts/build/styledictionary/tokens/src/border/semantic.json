{
	"border": {
		"$type": "color",
		"$description": "Named border color presets",
		"subtle": {
			"$value": "#005c4a38",
			"$description": "Default container border",
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-mint-700) l c h / 0.22)"
				}
			}
		},
		"strong": {
			"$value": "#0078614d",
			"$description": "Emphasized container border",
			"$extensions": {
				"com.coldlight": {
					"cssRuntime": true,
					"cssExpression": "oklch(from var(--color-mint-600) l c h / 0.30)"
				}
			}
		},
		"focus": {
			"$value": "{color.mint.400}",
			"$description": "Focus ring color"
		},
		"divider": {
			"$value": "#ffffff0f",
			"$description": "Section separator"
		}
	}
}
