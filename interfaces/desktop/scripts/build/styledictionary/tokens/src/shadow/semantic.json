{
	"elevation": {
		"$type": "shadow",
		"$description": "Named elevation presets — what the component IS, not a z-number",
		"flat":     { "$value": "{shadow.z0}", "$description": "No elevation — inline content" },
		"card":     { "$value": "{shadow.z1}", "$description": "Card, tile, badge" },
		"panel":    { "$value": "{shadow.z2}", "$description": "Side panel, drawer" },
		"dropdown": { "$value": "{shadow.z3}", "$description": "Menu, dropdown, popover" },
		"modal":    { "$value": "{shadow.z4}", "$description": "Dialog, modal, toast" }
	}
}
