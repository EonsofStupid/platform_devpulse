{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": [
		"src/routes/**/+*.{ts,svelte}",
		"src/hooks.{client,server}.ts",
		"src/app.d.ts",
		"scripts/**/*.{mjs,ts}",
		"src/lib/design/index.css"
	],
	"project": ["src/**/*.{ts,svelte,css}", "scripts/**/*.{mjs,ts}"],
	"ignore": [
		"src/lib/bindings/**",
		"src/lib/design/types/**",
		"src/lib/design/.cowlevel/**",
		"src/stories/**"
	],
	"ignoreDependencies": ["@fontsource/*", "prisma"],
	"rules": {
		"files": "error",
		"exports": "warn",
		"types": "warn",
		"dependencies": "warn",
		"unlisted": "warn",
		"duplicates": "warn"
	}
}
