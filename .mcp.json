{
  "mcpServers": {
    "surrealdb": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "SURREALDB_URL=ws://host.docker.internal:8000/rpc",
        "-e", "SURREALDB_NS=projects",
        "-e", "SURREALDB_DB=devpulse",
        "-e", "SURREALDB_USER=root",
        "-e", "SURREALDB_PASS=root",
        "ghcr.io/surrealdb/surrealmcp:latest"
      ]
    },
    "context7": {
      "command": "npx.cmd",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "ctx7sk-2ee50c50-bb37-44af-ad7c-83a76b874a69"
      }
    }
  }
}
