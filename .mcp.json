{
  "mcpServers": {
    "surrealdb-banter": {
      "command": "uvx",
      "args": ["surreal-mcp"],
      "env": {
        "SURREAL_URL": "ws://localhost:8000/rpc",
        "SURREAL_USER": "root",
        "SURREAL_PASSWORD": "root",
        "SURREAL_NAMESPACE": "banter",
        "SURREAL_DATABASE": "sessions"
      }
    }
  }
}
