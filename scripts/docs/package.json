{
  "name": "@devpulse/docs-enforcement",
  "version": "1.0.0",
  "description": "Documentation enforcement system for DevPulse platform",
  "type": "module",
  "scripts": {
    "preflight:check": "tsx preflight/engine/preflight.ts --check",
    "preflight:fix": "tsx preflight/engine/preflight.ts --fix",
    "preflight:dry-run": "tsx preflight/engine/preflight.ts --dry-run",
    "scan": "tsx pipeline/scan.ts",
    "validate": "tsx pipeline/validate.ts",
    "extract": "tsx pipeline/extract/typedoc.ts",
    "stage": "tsx pipeline/stage.ts",
    "lock": "tsx pipeline/lock.ts",
    "verify": "tsx pipeline/verify.ts",
    "lint:plans": "tsx pipeline/lint-plan.ts",
    "lint:plans:self": "tsx pipeline/lint-plan.ts --self",
    "knowledge:build": "node ../knowledge_library/build.mjs",
    "check": "pnpm scan && pnpm validate && pnpm preflight:check"
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "glob": "^14.0.3",
    "yaml": "^2.9.1",
    "ajv": "^8.20.0",
    "chalk": "^6.0.1",
    "prompts": "^2.4.2",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/mdast": "^4.0.4"
  }
}
