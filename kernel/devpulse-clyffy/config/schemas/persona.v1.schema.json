{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpulselabs.local/schemas/persona.v1.schema.json",
  "title": "dpl.persona/1 — a character a seat can speak as",
  "description": "A full character: name, tone, backstory and expertise, added to the seated role's prompt. The role still decides the method, the limits and the output (owner ruling 2026-10-21, plan 0001 B4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "summary",
    "tone",
    "backstory",
    "expertise"
  ],
  "properties": {
    "schema": { "const": "dpl.persona/1" },
    "id": {
      "description": "Stable kebab-case key.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "version": {
      "description": "Semver; a breaking change bumps the major.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "summary": {
      "description": "One line shown where you pick a persona for a seat.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tone": {
      "description": "How the character speaks.",
      "enum": ["objective", "empathetic", "strict", "concise"]
    },
    "backstory": {
      "description": "Who the character is.",
      "type": "string",
      "minLength": 1
    },
    "expertise": {
      "description": "What the character knows well.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "instructions": {
      "description": "Anything else about how the character answers.",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
