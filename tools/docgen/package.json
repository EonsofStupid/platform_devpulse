{
  "name": "@devpulse/docgen",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation generator for DevPulse - extracts props from TypeScript interfaces",
  "type": "module",
  "scripts": {
    "extract": "tsx src/extract-props.ts",
    "extract:primitives": "tsx src/extract-props.ts --target primitives",
    "extract:all": "tsx src/extract-props.ts --target all"
  },
  "dependencies": {
    "ts-morph": "^24.0.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "@types/node": "^22.0.0"
  }
}
