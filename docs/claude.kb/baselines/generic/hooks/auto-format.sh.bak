#!/usr/bin/env bash
# auto-format.sh — PostToolUse hook for Write|Edit
# Auto-detects formatter by file extension
set -uo pipefail

# Get file path from tool input
FILE=$(echo "$CLAUDE_TOOL_INPUT" 2>/dev/null | node -e "
  try { const i=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));
  console.log(i.file_path||i.path||'') } catch{}" 2>/dev/null)

[ -z "$FILE" ] && exit 0

case "$FILE" in
  *.rs)     rustfmt "$FILE" 2>/dev/null ;;
  *.ts|*.tsx|*.js|*.jsx|*.svelte|*.css|*.json|*.md)
            npx prettier --write "$FILE" 2>/dev/null ;;
  *.py)     command -v black &>/dev/null && black -q "$FILE" 2>/dev/null ;;
esac

exit 0  # Never block on format failure