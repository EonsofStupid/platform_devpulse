#!/usr/bin/env bash
# verify-on-stop.sh — Generic CC-001 countermeasure
# Auto-detects project type. Exit 2 forces Claude to keep working.
set -uo pipefail
ERRORS=0

if [ -f "Cargo.toml" ]; then
  echo "Checking Rust..." >&2
  cargo check 2>&1 | tail -3 >&2 || ERRORS=$((ERRORS + 1))
fi

if [ -f "package.json" ]; then
  if command -v npx &>/dev/null; then
    if grep -q '"tsc"' package.json 2>/dev/null || [ -f "tsconfig.json" ]; then
      echo "Checking TypeScript..." >&2
      npx tsc --noEmit 2>&1 | tail -3 >&2 || ERRORS=$((ERRORS + 1))
    fi
  fi
fi

if [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
  CHANGED_PY=$(git diff --name-only -- '*.py' 2>/dev/null)
  if [ -n "$CHANGED_PY" ]; then
    echo "Checking Python..." >&2
    for f in $CHANGED_PY; do
      python -m py_compile "$f" 2>&1 >&2 || ERRORS=$((ERRORS + 1))
    done
  fi
fi

if [ $ERRORS -gt 0 ]; then
  echo "❌ Verification FAILED. Fix errors before completing." >&2
  exit 2
fi
echo "✅ Passed." >&2
exit 0