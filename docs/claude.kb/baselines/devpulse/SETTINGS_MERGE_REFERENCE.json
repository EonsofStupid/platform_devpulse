{
  "_README": "MERGE these entries INTO your existing .claude/settings.json",
  "_WARNING": "Do NOT replace. Add alongside existing hooks.",

  "hooks_to_merge": {

    "UserPromptSubmit": {
      "_note": "ADD this alongside existing save-chat.js hook",
      "hooks": [{
        "type": "command",
        "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/psych-translator.js\"",
        "timeout": 5
      }]
    },

    "Stop": {
      "_note": "NEW — CC-001 countermeasure. Does not exist in current settings.",
      "hooks": [{
        "type": "command",
        "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/verify-on-stop.js\"",
        "timeout": 60
      }]
    },

    "PostToolUse_addition": {
      "_note": "ADD this alongside existing track-files.js hook",
      "matcher": "Write|Edit",
      "hooks": [{
        "type": "command",
        "command": "node \"d:/localdev/platform_devpulse/.claude/hooks/auto-format.js\"",
        "timeout": 10
      }]
    },

    "PreToolUse_new": {
      "_note": "NEW — Security gate. Block pip/docker/destructive.",
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "command": "node -e \"const i=require('fs').readFileSync(0,'utf8');if(/pip install|pip3 install|docker |rm -rf \\//i.test(i)){process.stderr.write('BLOCKED: prohibited command');process.exit(2)}\"",
        "timeout": 5
      }]
    }
  },

  "permissions_to_add_to_deny": [
    "Bash(pip install:*)",
    "Bash(pip3 install:*)",
    "Bash(python -m pip:*)",
    "Bash(docker:*)"
  ]
}
