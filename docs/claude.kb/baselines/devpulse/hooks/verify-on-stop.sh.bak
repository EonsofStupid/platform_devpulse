#!/usr/bin/env bash
# verify-on-stop.sh — CC-001 countermeasure
# Forces Claude to keep working if verification fails (exit 2)
# Polyglot: auto-detects Rust, TypeScript, Svelte, Python
set -uo pipefail

ERRORS=0
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-.}"

# Rust verification
if [ -f "$PROJECT_DIR/Cargo.toml" ]; then
  echo "Verifying Rust..." >&2
  # Check only changed crates, not full workspace
  CHANGED_RS=$(git diff --name-only -- '*.rs' 2>/dev/null | head -5)
  if [ -n "$CHANGED_RS" ]; then
    # Extract crate from path (systems/engine/src/... → devpulse-engine)
    for f in $CHANGED_RS; do
      CRATE_DIR=$(echo "$f" | cut -d'/' -f1-2)
      if [ -f "$PROJECT_DIR/$CRATE_DIR/Cargo.toml" ]; then
        CRATE_NAME=$(grep '^name' "$PROJECT_DIR/$CRATE_DIR/Cargo.toml" | head -1 | sed 's/.*"\(.*\)"/\1/')
        if [ -n "$CRATE_NAME" ]; then
          cargo check -p "$CRATE_NAME" 2>&1 | tail -3 >&2 || ERRORS=$((ERRORS + 1))
          break  # One crate check is enough to catch issues
        fi
      fi
    done
  fi
fi

# Svelte/TypeScript verification
if [ -f "$PROJECT_DIR/interfaces/desktop/package.json" ]; then
  CHANGED_TS=$(git diff --name-only -- '*.ts' '*.svelte' 2>/dev/null | head -5)
  if [ -n "$CHANGED_TS" ]; then
    echo "Verifying Svelte/TypeScript..." >&2
    (cd "$PROJECT_DIR/interfaces/desktop" && npx svelte-check 2>&1 | tail -5 >&2) || ERRORS=$((ERRORS + 1))
  fi
fi

# Python verification (if any .py files changed)
CHANGED_PY=$(git diff --name-only -- '*.py' 2>/dev/null)
if [ -n "$CHANGED_PY" ]; then
  echo "Verifying Python..." >&2
  for f in $CHANGED_PY; do
    python -m py_compile "$f" 2>&1 >&2 || ERRORS=$((ERRORS + 1))
  done
fi

# Verdict
if [ $ERRORS -gt 0 ]; then
  echo "❌ Verification FAILED ($ERRORS errors). Fix before completing." >&2
  exit 2  # Exit 2 = forces Claude to keep working
fi

echo "✅ Verification passed." >&2
exit 0