root ::= "{" ws mission-plan ws "}"
mission-plan ::= objective "," ws approach "," ws steps "," ws success "," ws abort
objective ::= "\"objective\"" ws ":" ws string
approach ::= "\"approach\"" ws ":" ws string
steps ::= "\"steps\"" ws ":" ws "[" ws string-list ws "]"
success ::= "\"success_criteria\"" ws ":" ws "[" ws string-list ws "]"
abort ::= "\"abort_conditions\"" ws ":" ws "[" ws string-list ws "]"
string-list ::= string ("," ws string)*
string ::= "\"" [^"]* "\""
ws ::= [ \t\n]*
