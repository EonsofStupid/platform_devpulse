{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevPulse",
  "version": "0.1.0",
  "identifier": "com.devpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DevPulse",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "chat",
        "title": "Maestro",
        "url": "/chat-window",
        "width": 420,
        "height": 700,
        "minWidth": 320,
        "minHeight": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
